---
import SectionHead from "./SectionHead.astro";
import IsoFigure from "./IsoFigure.astro";
const security = [
  ["SEC-01", "Threat detection & monitoring", "Detection rules and alerting built on the platform's audit ledger and infrastructure telemetry."],
  ["SEC-02", "Security assessments", "Infrastructure and application reviews, penetration testing and hardening for self-hosted and cloud-native environments."],
  ["SEC-03", "Compliance readiness", "Access controls, audit trails and tenant isolation, mapped to the frameworks your auditors work with."],
];
const enterprise = [
  ["ENT-01", "SAP", "Implementation, migration and integration, connected to infrastructure you control rather than one vendor's cloud."],
  ["ENT-02", "Oracle", "Database administration, migration and application support, on-premises or hybrid."],
  ["ENT-03", "Managed Kubernetes", "Isolated virtual clusters with direct kubectl access, delivered on the InfraLedger provider layer."],
];
---
<section class="sec" id="security">
  <div class="wrap">
    <SectionHead
      num="05"
      label="Security & enterprise"
      title="The ledger is where detection starts."
      lead="Every deploy, login, configuration change and network decision passes through InfraLedger and is recorded with its actor, time and outcome. Our security team builds detection on that record, and on the systems around it."
    />

    <div class="grid sec__split">
      <IsoFigure />

      <div class="sec__copy">
        <h3 class="h3">Isolation that's enforced, not named.</h3>
        <p class="body-2">Each project runs on its own private network, and roles are checked on every API call, not just hidden in the interface. When something crosses a boundary it isn't allowed to, it's blocked and becomes a ledger entry your team can investigate.</p>
        <ul class="cap-spec mono">
          <li>Owner / Admin / Member, enforced server-side</li>
          <li>Audit log of every deploy, restart and admin action</li>
          <li>Platform admin can suspend abusive tenants</li>
        </ul>
      </div>
    </div>

    <div class="idx" data-rise>
      <p class="label idx__h">Security services <a class="ulink idx__more" href="/security">All security services →</a></p>
      {security.map(([c, t, d]) => (
        <div class="idx__row"><span class="mono idx__c">{c}</span><span class="idx__t">{t}</span><span class="idx__d">{d}</span></div>
      ))}
    </div>

    <div class="idx" id="enterprise" data-rise>
      <p class="label idx__h">Enterprise systems <a class="ulink idx__more" href="/enterprise">All enterprise services →</a></p>
      {enterprise.map(([c, t, d]) => (
        <div class="idx__row"><span class="mono idx__c">{c}</span><span class="idx__t">{t}</span><span class="idx__d">{d}</span></div>
      ))}
    </div>
  </div>
</section>

<style>
  .sec__split { align-items: center; row-gap: 48px; margin-bottom: 104px; }
  .sec__split > :global(.iso) { grid-column: 1 / span 7; }
  .sec__copy { grid-column: 9 / span 4; }
  @media (max-width: 960px) { .sec__split > :global(.iso), .sec__copy { grid-column: 1 / -1; } }


  .sec__copy .body-2 { margin-top: 14px; }
  .cap-spec { list-style: none; margin-top: 28px; font-size: 12.5px; color: var(--ink-2); }
  .cap-spec li { padding: 10px 0; border-top: 1px solid var(--rule); }
  .cap-spec li:last-child { border-bottom: 1px solid var(--rule); }

  .idx { margin-top: 64px; }
  .idx__h { padding-bottom: 14px; border-bottom: 1px solid var(--ink); display: flex; justify-content: space-between; gap: 16px; }
  .idx__more { color: var(--ink); text-transform: none; letter-spacing: 0; font-size: 13px; }
  .idx__row {
    display: grid; grid-template-columns: 96px minmax(0, 3fr) minmax(0, 5fr); column-gap: var(--gutter);
    padding: 22px 0; border-bottom: 1px solid var(--rule); align-items: baseline;
  }
  .idx__c { font-size: 12px; color: var(--signal); }
  .idx__t { font-size: 20px; font-weight: 500; letter-spacing: -0.01em; }
  .idx__d { color: var(--ink-2); font-size: 15px; }
  @media (max-width: 760px) {
    .idx__row { grid-template-columns: 72px 1fr; row-gap: 6px; }
    .idx__d { grid-column: 2; }
  }
</style>
