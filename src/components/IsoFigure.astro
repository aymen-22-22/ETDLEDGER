---
---
<figure class="iso" data-iso>
  <svg viewBox="0 0 560 350" role="img" aria-labelledby="iso-t">
    <title id="iso-t">A request from another organization is denied at the network boundary and logged.</title>
    <defs>
      <filter id="iso-glow" x="-200%" y="-200%" width="500%" height="500%">
        <feGaussianBlur stdDeviation="4" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
    <rect class="iso__org" x="20" y="30" width="250" height="270" rx="12" />
    <text class="iso__lbl" x="40" y="60">org / acme · prod</text>
    <rect class="iso__org" x="310" y="30" width="230" height="270" rx="12" />
    <text class="iso__lbl" x="330" y="60">org / globex · web</text>

    <rect class="iso__node" x="50" y="100" width="130" height="40" rx="8" />
    <text class="iso__nt" x="66" y="125">api-prod</text>
    <rect class="iso__node" x="50" y="220" width="130" height="40" rx="8" />
    <text class="iso__nt" x="66" y="245">pg-main</text>
    <rect class="iso__node" x="370" y="220" width="140" height="40" rx="8" />
    <text class="iso__nt" x="386" y="245">web-frontend</text>

    <line class="iso__ok" data-iso-ok x1="115" y1="140" x2="115" y2="220" />
    <text class="iso__tag" x="124" y="184">allowed</text>

    <line class="iso__bad" data-iso-bad x1="370" y1="240" x2="276" y2="240" />
    <circle class="iso__pulse" data-iso-pulse cx="270" cy="240" r="11" />
    <circle class="iso__dot" data-iso-dot cx="276" cy="240" r="3.5" filter="url(#iso-glow)" />
    <g data-iso-x>
      <circle class="iso__xc" cx="270" cy="240" r="11" filter="url(#iso-glow)" />
      <path class="iso__xp" d="M265,235 L275,245 M275,235 L265,245" />
    </g>
    <text class="iso__note" data-iso-note x="290" y="332" text-anchor="middle">denied · cross-tenant · ledger #48211</text>
  </svg>
  <figcaption class="label iso__cap">Fig. 1 — Per-organization network isolation</figcaption>
</figure>

<style>
  .iso svg { width: 100%; height: auto; font-family: var(--mono); overflow: visible; }
  .iso__org { fill: var(--surface); stroke: var(--rule-strong); stroke-dasharray: 4 5; stroke-opacity: 0.6; }
  .iso__lbl { font-size: 12px; fill: var(--ink-3); }
  .iso__node { fill: var(--surface-2); stroke: var(--rule-strong); }
  .iso__nt { font-size: 13px; fill: var(--ink); }
  .iso__ok { stroke: var(--ink-2); stroke-width: 1.5; }
  .iso__tag { font-size: 11px; fill: var(--ink-3); }
  .iso__bad { stroke: var(--signal); stroke-width: 1.5; stroke-dasharray: 5 4; stroke-opacity: 0.55; }
  .iso__dot { fill: var(--signal); opacity: 0; }
  .iso__pulse { fill: none; stroke: var(--signal); stroke-width: 1.5; opacity: 0; }
  .iso__xc { fill: var(--signal); }
  .iso__xp { stroke: #fff; stroke-width: 1.75; fill: none; }
  .iso__note { font-size: 12px; fill: var(--signal-ink); }
  .iso__cap { margin-top: 16px; }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const fig = document.querySelector("[data-iso]");
  if (fig && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const packet = () =>
      gsap.timeline({ defaults: { ease: "power2.in" } })
        .fromTo("[data-iso-dot]", { attr: { cx: 370 }, opacity: 0 }, { attr: { cx: 276 }, opacity: 1, duration: 1.1 })
        .set("[data-iso-dot]", { opacity: 0 })
        .fromTo("[data-iso-pulse]", { attr: { r: 11 }, opacity: 0.8 }, { attr: { r: 36 }, opacity: 0, duration: 0.9, ease: "power3.out" }, "<");

    const tl = gsap.timeline({ paused: true, defaults: { ease: "power3.out" } });
    tl.from("[data-iso-ok]", { attr: { y2: 140 }, duration: 0.6 })
      .from("[data-iso-bad]", { attr: { x2: 370 }, duration: 0.9, ease: "power2.inOut" }, "+=0.2")
      .add(packet(), "-=0.2")
      .from("[data-iso-x]", { scale: 0, transformOrigin: "50% 50%", duration: 0.35 }, "-=0.9")
      .from("[data-iso-note]", { opacity: 0, y: 6, duration: 0.4 }, "+=0.1")
      .add(() => {
        gsap.timeline({ repeat: -1, repeatDelay: 2.4 }).add(packet());
      });
    ScrollTrigger.create({ trigger: fig, start: "top 70%", once: true, onEnter: () => tl.play() });
  }
</script>
