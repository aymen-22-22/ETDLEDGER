---
// Map of Algeria drawn at build time from Natural Earth data (world-atlas, public domain), with the
// neighbouring countries for context and ETDLedger's office in Sidi Bel Abbès marked with the red line.
import { feature } from "topojson-client";
import { geoMercator, geoPath } from "d3-geo";
import world from "world-atlas/countries-50m.json";

interface Props { caption?: string; size?: "md" | "sm" }
const { caption, size = "md" } = Astro.props;

const W = 600, H = 560;
// Topology → GeoJSON features, keyed by ISO 3166 numeric code.
const countries = (feature(world as any, (world as any).objects.countries) as any).features as any[];
const byId = (id: string) => countries.find((c) => c.id === id);
const algeria = byId("012");
const neighbours = ["504", "732", "478", "466", "562", "434", "788", "724", "380", "250", "620"].map(byId).filter(Boolean);

const projection = geoMercator().fitExtent([[60, 40], [W - 40, H - 30]], algeria);
const path = geoPath(projection);
const pt = (lon: number, lat: number) => projection([lon, lat]) as [number, number];

const hq = pt(-0.6417, 35.1899);
const cities = [
  { name: "Algiers", at: pt(3.0588, 36.7538), dx: 8, dy: -8 },
  { name: "Constantine", at: pt(6.6147, 36.365), dx: 8, dy: 14 },
  { name: "Ouargla", at: pt(5.3333, 31.95), dx: 8, dy: 4 },
  { name: "Tamanrasset", at: pt(5.5228, 22.785), dx: 8, dy: 4 },
];
const label: [number, number] = [hq[0] - 30, hq[1] + 70];
const lh = size === "sm" ? 30 : 21; // line height of the office label, in map units
---
<figure class:list={["map", `map--${size}`]}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Map of Algeria with ETDLedger's office in Sidi Bel Abbès">
    <defs>
      <pattern id="dz-dots" width="12" height="12" patternUnits="userSpaceOnUse"><circle class="map__dot" cx="6" cy="6" r="1.1" /></pattern>
    </defs>
    {neighbours.map((c) => <path class="map__nb" d={path(c)} />)}
    <path class="map__dz" d={path(algeria)} />
    <path d={path(algeria)} fill="url(#dz-dots)" />
    <path class="map__edge" d={path(algeria)} />
    {cities.map((c) => (
      <g class="map__city">
        <circle cx={c.at[0]} cy={c.at[1]} r="3.5" />
        <text x={c.at[0] + c.dx} y={c.at[1] + c.dy}>{c.name}</text>
      </g>
    ))}
    <g class="map__hq">
      <circle class="map__pulse" cx={hq[0]} cy={hq[1]} r="6" />
      <circle cx={hq[0]} cy={hq[1]} r="5" />
      <path d={`M${hq[0]} ${hq[1] + 6} V${label[1] - 14}`} />
      <text x={label[0]} y={label[1]}><tspan class="map__hq-name">ETDLedger</tspan></text>
      <text x={label[0]} y={label[1] + lh}>Sidi Bel Abbès</text>
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .map { margin: 0; min-width: 0; }
  .map svg { display: block; width: 100%; height: auto; }
  .map--sm svg { max-width: 300px; }
  .map__nb { fill: none; stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 3; }
  .map__dz { fill: var(--surface); }
  .map__dot { fill: var(--border-strong); }
  .map__edge { fill: none; stroke: var(--text-3); stroke-width: 1.2; stroke-linejoin: round; }
  .map__city circle { fill: var(--text-3); }
  .map__city text { font: 15px var(--sans); fill: var(--text-2); }
  .map__hq circle { fill: var(--brand-red); }
  .map__hq path { stroke: var(--brand-red); stroke-width: 2; }
  .map__hq text { font: 16px var(--sans); fill: var(--text-2); }
  .map__hq-name { font-weight: 600; fill: var(--text); }
  .map--sm .map__city text { display: none; }
  .map--sm .map__hq text { font-size: 25px; }
  .map__pulse { transform-box: fill-box; transform-origin: center; animation: map-pulse 2.4s ease-out infinite; }
  @keyframes map-pulse { from { transform: scale(1); opacity: 0.5; } to { transform: scale(4); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .map__pulse { animation: none; opacity: 0; } }
  .map figcaption { margin-top: 12px; font-size: 13px; color: var(--text-3); }
</style>
