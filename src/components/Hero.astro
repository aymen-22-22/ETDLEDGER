---
import { u } from "../lib/url";
const seed = [
  { t: "14:02:41", actor: "m.okafor", text: "Deployment succeeded", res: "api-prod", ref: "a3f9c1e", s: "ok" },
  { t: "14:02:17", actor: "system", text: "Backup completed", res: "pg-main", ref: "7c21d04", s: "ok" },
  { t: "14:01:58", actor: "unknown", text: "Anomalous login — 6 failed attempts", res: "auth/sso", ref: "e90b3fa", s: "bad", status: "Blocked" },
  { t: "14:01:30", actor: "l.duarte", text: "Scaled to 4 replicas", res: "web-frontend", ref: "1d4e8b2", s: "ok" },
  { t: "14:01:04", actor: "s.haddad", text: "Env var DATABASE_URL updated", res: "billing-svc", ref: "f03a6c9", s: "ok" },
  { t: "14:00:39", actor: "system", text: "Redis instance provisioned", res: "cache-eu", ref: "b58e271", s: "ok" },
  { t: "14:00:12", actor: "m.okafor", text: "Routing rule added /v2/*", res: "api-prod", ref: "4ac9d10", s: "ok" },
];
const stack = ["Docker", "Kubernetes", "vcluster", "PostgreSQL", "Redis", "Traefik", "Prometheus", "RabbitMQ"];
---
<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="wrap hero__in">
    <a class="hero__kicker" href={u("/platform")}>
      <span class="hero__dot"></span>
      <span>InfraLedger</span>
      <span class="hero__sep"></span>
      <span class="hero__kmuted">The self-hosted cloud platform</span>
      <span class="arrow">→</span>
    </a>
    <h1 class="display hero__title" data-hero-in>Your own cloud.{" "}<br /><span class="hero__em">On the record.</span></h1>
    <p class="lead hero__lead" data-hero-in>
      InfraLedger turns your servers into a self-service platform for apps and databases,
      and writes every action to an audit ledger your security team can act on.
    </p>
    <div class="hero__ctas" data-hero-in>
      <a href={u("/contact?interest=platform")} class="btn btn--solid">Request a demo <span class="arrow">→</span></a>
      <a href="#architecture" class="btn btn--line">See how it works</a>
    </div>
  </div>

  <div class="wrap hero__stage" data-hero-stage>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="frame ledger" data-ledger data-glow aria-label="Example audit ledger">
      <div class="frame__bar">
        <div class="frame__crumbs"><span>acme</span><span>/</span><b>audit ledger</b></div>
        <div class="ledger__live"><span class="ledger__dot"></span>Live</div>
      </div>
      <div class="ledger__row ledger__row--head">
        <span>Time</span><span>Actor</span><span>Event</span><span class="c-res">Resource</span><span class="c-ref">Ref</span><span class="c-st">Status</span>
      </div>
      <div class="ledger__body" data-ledger-body>
        <span class="ledger__scan" aria-hidden="true"></span>
        {seed.map((r) => (
          <div class:list={["ledger__row", { "is-bad": r.s === "bad" }]}>
            <span class="mono c-t">{r.t}</span>
            <span class="mono">{r.actor}</span>
            <span class="c-ev">{r.text}</span>
            <span class="mono c-res">{r.res}</span>
            <span class="mono c-ref">{r.ref}</span>
            <span class="c-st"><span class:list={["pill", r.s === "bad" ? "pill--bad" : "pill--ok"]}>{r.status ?? "Recorded"}</span></span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="wrap hero__stack">
    <p class="label">Built on open infrastructure</p>
    <ul class="mono">{stack.map((s) => <li>{s}</li>)}</ul>
  </div>
</section>

<style>
  .hero { position: relative; margin-top: -64px; padding: 160px 0 0; overflow: hidden; }
  .hero__bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(900px 420px at 50% -80px, color-mix(in srgb, var(--signal) 16%, transparent), transparent 70%),
      repeating-linear-gradient(to bottom, transparent 0 47px, var(--rule-soft) 47px 48px);
    -webkit-mask: radial-gradient(1100px 620px at 50% 0, #000 30%, transparent 75%);
    mask: radial-gradient(1100px 620px at 50% 0, #000 30%, transparent 75%);
  }
  .hero__in { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero__kicker {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 14px 6px 10px; border-radius: 999px;
    border: 1px solid var(--rule); background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 13px; color: var(--ink);
    transition: border-color 200ms var(--ease);
  }
  .hero__kicker:hover { border-color: var(--rule-strong); }
  .hero__kicker .arrow { color: var(--ink-3); transition: transform 200ms var(--ease); }
  .hero__kicker:hover .arrow { transform: translateX(2px); }
  .hero__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 10px var(--signal-glow); }
  .hero__sep { width: 1px; height: 12px; background: var(--rule); }
  .hero__kmuted { color: var(--ink-2); }
  .hero__title { margin-top: 32px; max-width: 14ch; }
  .hero__em { color: var(--ink-3); }
  .hero__lead { margin-top: 28px; max-width: 600px; }
  .hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 36px; }
  @media (max-width: 600px) {
    .hero__kmuted, .hero__sep { display: none; }
  }

  .hero__stage { position: relative; margin-top: 88px; perspective: 1800px; }
  .hero__glow {
    position: absolute; left: 10%; right: 10%; top: 8%; height: 70%;
    background: radial-gradient(closest-side, var(--signal-glow), transparent);
    opacity: 0.22; filter: blur(40px); pointer-events: none;
  }
  .hero__stage .ledger { transform-origin: 50% 0; will-change: transform; }

  .hero__stack {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 18px;
    margin-top: 72px; padding-top: 32px;
  }
  .hero__stack ul {
    list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 32px;
    font-size: 14px; color: var(--ink-2);
  }
</style>

<style is:global>
  .ledger { --row: 46px; }
  .ledger__live { display: flex; align-items: center; gap: 8px; color: var(--ink-2); }
  .ledger__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); animation: ledger-pulse 2.4s var(--ease) infinite; }
  @keyframes ledger-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 50%, transparent); }
    70%, 100% { box-shadow: 0 0 0 7px transparent; }
  }

  .ledger__body { position: relative; height: calc(var(--row) * 7); overflow: hidden; }
  .ledger__scan {
    position: absolute; left: 0; top: 0; width: 1px; height: 120px; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--signal), transparent);
    box-shadow: 0 0 12px var(--signal-glow);
    animation: ledger-scan 4.5s var(--ease) infinite;
  }
  @keyframes ledger-scan {
    0% { transform: translateY(-120px); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(calc(var(--row) * 7)); opacity: 0; }
  }

  .ledger__row {
    display: grid;
    grid-template-columns: 92px 104px minmax(0, 1fr) 132px 92px 112px;
    align-items: center; column-gap: 16px;
    height: var(--row); padding: 0 16px;
    border-bottom: 1px solid var(--rule-soft);
    overflow: hidden; position: relative;
  }
  .ledger__row > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ledger__row .mono { font-size: 12.5px; color: var(--ink-2); }
  .ledger__row .c-t { color: var(--ink-3); }
  .ledger__row--head {
    height: 34px; background: var(--paper-2);
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3);
  }
  .c-st { justify-self: end; }
  .ledger__row.is-bad { background: var(--signal-soft); }
  .ledger__row.is-bad::before {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 2px;
    background: var(--signal); box-shadow: 0 0 12px var(--signal-glow);
  }
  .ledger__row.is-bad .c-ev { color: var(--signal-ink); font-weight: 500; }
  .ledger__row.is-ignite { animation: ledger-ignite 1.8s var(--ease); }
  @keyframes ledger-ignite {
    0% { background: color-mix(in srgb, var(--signal) 32%, transparent); box-shadow: inset 0 0 40px -10px var(--signal-glow); }
    100% { background: var(--signal-soft); box-shadow: inset 0 0 0 0 transparent; }
  }

  @media (max-width: 860px) {
    .ledger__row { grid-template-columns: 76px minmax(0, 1fr) 96px; }
    .ledger__row > :nth-child(2), .c-res, .c-ref { display: none; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const events = [
    { actor: "m.okafor", text: "Deployment succeeded", res: "api-prod" },
    { actor: "l.duarte", text: "Scaled to 3 replicas", res: "web-frontend" },
    { actor: "system", text: "Backup completed", res: "pg-main" },
    { actor: "s.haddad", text: "Role changed Member → Admin", res: "org/acme" },
    { actor: "system", text: "Scheduled job ran", res: "nightly-report" },
    { actor: "a.kim", text: "Rolled back to 4ac9d10", res: "checkout" },
    { actor: "l.duarte", text: "Preview environment created", res: "pr-218" },
    { actor: "system", text: "TLS certificate renewed", res: "api.acme.io" },
    { actor: "a.kim", text: "Postgres 16 database created", res: "pg-analytics" },
    { actor: "s.haddad", text: "IP allow-list updated", res: "admin-panel" },
  ];
  const threats = [
    { actor: "web-frontend", text: "Cross-project network access denied", res: "pg-main", status: "Denied" },
    { actor: "unknown", text: "Anomalous login — 9 failed attempts", res: "auth/sso", status: "Blocked" },
    { actor: "j.weber", text: "Console exec outside change window", res: "billing-svc", status: "Flagged" },
  ];

  const body = document.querySelector<HTMLElement>("[data-ledger-body]");
  const stage = document.querySelector<HTMLElement>("[data-hero-stage] .ledger");
  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    gsap.from("[data-hero-in]", { y: 18, opacity: 0, duration: 0.9, ease: "power3.out", stagger: 0.08 });
    gsap.from(".hero__kicker", { y: 10, opacity: 0, duration: 0.7, ease: "power3.out" });

    if (stage) {
      gsap.fromTo(stage,
        { rotateX: 22, scale: 0.94, y: 40, opacity: 0 },
        { rotateX: 22, scale: 0.94, y: 0, opacity: 1, duration: 1.2, ease: "power3.out", delay: 0.25 });
      gsap.to(stage, {
        rotateX: 0, scale: 1, ease: "none",
        scrollTrigger: { trigger: stage, start: "top 85%", end: "top 25%", scrub: 0.6 },
      });
    }

    if (!body) return;
    const hex = () => Math.random().toString(16).slice(2, 9).padEnd(7, "0");
    const pad = (n: number) => String(n).padStart(2, "0");
    let clock = new Date();
    clock.setHours(14, 2, 41);
    let i = 0;
    let ti = 0;

    const cell = (cls: string, text: string) => {
      const s = document.createElement("span");
      s.className = cls;
      s.textContent = text;
      return s;
    };

    const makeRow = () => {
      i++;
      const bad = i % 5 === 0;
      const e = bad ? threats[ti++ % threats.length] : events[(i * 3) % events.length];
      clock = new Date(clock.getTime() + (12 + Math.floor(Math.random() * 30)) * 1000);
      const row = document.createElement("div");
      row.className = "ledger__row" + (bad ? " is-bad is-ignite" : "");
      row.append(
        cell("mono c-t", `${pad(clock.getHours())}:${pad(clock.getMinutes())}:${pad(clock.getSeconds())}`),
        cell("mono", e.actor),
        cell("c-ev", e.text),
        cell("mono c-res", e.res),
        cell("mono c-ref", hex()),
      );
      const st = cell("c-st", "");
      st.append(cell(`pill ${bad ? "pill--bad" : "pill--ok"}`, bad ? (e as { status: string }).status : "Recorded"));
      row.append(st);
      return row;
    };

    const tick = () => {
      const row = makeRow();
      body.querySelector(".ledger__scan")!.after(row);
      const h = getComputedStyle(body.parentElement!).getPropertyValue("--row") || "46px";
      gsap.fromTo(row, { height: 0, opacity: 0 }, { height: h, opacity: 1, duration: 0.5, ease: "power3.out" });
      const rows = body.querySelectorAll(".ledger__row");
      for (let j = 9; j < rows.length; j++) rows[j].remove();
    };

    let timer: number | undefined;
    let inView = false;
    const start = () => { if (!timer) timer = window.setInterval(tick, 2200); };
    const stop = () => { window.clearInterval(timer); timer = undefined; };
    const io = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      inView ? start() : stop();
    });
    io.observe(body);
    const onVis = () => (document.hidden ? stop() : inView && start());
    document.addEventListener("visibilitychange", onVis);
    return () => { stop(); io.disconnect(); document.removeEventListener("visibilitychange", onVis); };
  });
</script>
