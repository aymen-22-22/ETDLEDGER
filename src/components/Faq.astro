---
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map(([q, a]) => (
    <details class="faq__item" data-reveal>
      <summary>
        <span>{q}</span>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      </summary>
      <p>{a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--border); }
  .faq__item { border-bottom: 1px solid var(--border); }
  .faq__item summary {
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 22px 0; cursor: pointer; list-style: none; font-size: 18px; font-weight: 500; letter-spacing: -0.01em;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary svg { flex-shrink: 0; color: var(--text-2); transition: transform 200ms var(--ease); }
  .faq__item[open] summary svg { transform: rotate(45deg); }
  .faq__item p { padding: 0 48px 24px 0; color: var(--text-2); max-width: 760px; }
</style>
