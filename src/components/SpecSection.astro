---
import SectionHead from "./SectionHead.astro";
interface Props {
  id: string;
  num: string;
  label: string;
  title: string;
  lead?: string;
  items: [string, string][];
  night?: boolean;
}
const { id, num, label, title, lead, items, night = false } = Astro.props;
---
<section class:list={["sec", { night }]} id={id}>
  <div class="wrap">
    <SectionHead num={num} label={label} title={title} lead={lead} />
    {items.length > 0 && <div class="grid">
      <div class="spec">
        {items.map(([t, d], i) => (
          <div class="spec__row card" data-rise>
            <span class="mono spec__n">{String(i + 1).padStart(2, "0")}</span>
            <p class="spec__t">{t}</p>
            <p class="spec__d">{d}</p>
          </div>
        ))}
      </div>
    </div>}
    <slot />
  </div>
</section>

<style>
  .spec {
    grid-column: 4 / span 9;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .spec__row { display: flex; flex-direction: column; }
  .spec__n { font-size: 12px; color: var(--signal); margin-bottom: 20px; }
  .spec__t { font-weight: 600; font-size: 17px; letter-spacing: -0.015em; margin-bottom: 8px; }
  .spec__d { font-size: 15px; color: var(--ink-2); line-height: 1.6; }
  @media (max-width: 900px) {
    .spec { grid-column: 1 / -1; grid-template-columns: 1fr; }
  }
</style>
