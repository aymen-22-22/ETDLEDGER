---
import BrandLogo from "./BrandLogo.astro";
import Icon from "./Icon.astro";
const steps = [
  { brand: "siDocker", title: "Start on one server", provider: "Docker provider", text: "Run InfraLedger with Docker Compose on a single machine. No cluster needed." },
  { brand: "siKubernetes", title: "Grow onto Kubernetes", provider: "Kubernetes provider", text: "Move the same apps and databases onto a cluster, with no rewrite and no new workflow." },
  { brand: "siKubernetes", title: "Offer clusters to customers", provider: "Virtual clusters", text: "Give each customer an isolated virtual cluster with direct kubectl access." },
] as const;
---
<div class="gs" data-gs data-step="0">
  <ol class="gs__steps">
    {steps.map((s, i) => (
      <li>
        <button class="gs__step" type="button" aria-pressed={i === 0 ? "true" : "false"} data-i={i}>
          <span class="gs__n">{i + 1}</span>
          <span>
            <span class="gs__title">{s.title}</span>
            <span class="gs__prov"><BrandLogo brand={s.brand} size={14} decorative />{s.provider}</span>
            <span class="gs__text">{s.text}</span>
          </span>
        </button>
      </li>
    ))}
  </ol>

  <div class="gs__stage" aria-hidden="true">
    <div class="gs__layer"><span>Your apps and databases</span><span class="gs__chips"><i>web</i><i>api</i><i>pg-main</i><i>cache</i></span></div>
    <div class="gs__link"></div>
    <div class="gs__layer gs__layer--prov">
      <span>InfraLedger</span>
      <span class="gs__provs"><b data-v="0"><BrandLogo brand="siDocker" size={18} decorative />Docker provider</b><b data-v="1"><BrandLogo brand="siKubernetes" size={18} decorative />Kubernetes provider</b><b data-v="2"><BrandLogo brand="siKubernetes" size={18} decorative />Kubernetes · vcluster</b></span>
    </div>
    <div class="gs__link"></div>
    <div class="gs__infra">
      <div class="gs__v" data-v="0">
        <div class="gs__box"><span class="gs__label"><Icon name="Server" size={14} />server-01</span><span class="gs__pods"><i></i><i></i><i></i><i></i></span></div>
      </div>
      <div class="gs__v gs__v--3" data-v="1">
        {["node-a", "node-b", "node-c"].map((n) => <div class="gs__box"><span class="gs__label"><Icon name="Server" size={14} />{n}</span><span class="gs__pods"><i></i><i></i></span></div>)}
      </div>
      <div class="gs__v gs__v--2" data-v="2">
        {["customer-a", "customer-b"].map((n) => <div class="gs__box"><span class="gs__label"><Icon name="Boxes" size={14} />vcluster · {n}</span><span class="gs__pods"><i></i><i></i></span><span class="gs__kubectl">kubectl</span></div>)}
      </div>
    </div>
  </div>
</div>

<style>
  .gs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 48px; align-items: center; }
  .gs__steps { display: grid; gap: 8px; }
  .gs__step {
    display: grid; grid-template-columns: 32px 1fr; gap: 14px; width: 100%; text-align: left;
    padding: 18px; border: 1px solid transparent; border-radius: var(--radius-lg);
    transition: background-color 200ms var(--ease), border-color 200ms var(--ease);
  }
  .gs__step:hover { background: var(--surface); }
  .gs__step[aria-pressed="true"] { background: var(--surface); border-color: var(--border); }
  .gs__n {
    width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%;
    border: 1px solid var(--border-strong); font-size: 13px; font-weight: 600; color: var(--text-2);
  }
  .gs__step[aria-pressed="true"] .gs__n { background: var(--text); color: var(--bg); border-color: var(--text); }
  .gs__title { display: block; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
  .gs__prov { display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 12.5px; color: var(--text-2); margin-top: 4px; }
  .gs__text { display: block; margin-top: 8px; font-size: 15px; color: var(--text-2); }

  .gs__stage { padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .gs__layer {
    display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;
    padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); font-size: 14px; font-weight: 500;
  }
  .gs__layer--prov { border-color: var(--border-strong); }
  .gs__chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .gs__chips i { font-style: normal; font-family: var(--mono); font-size: 12px; font-weight: 400; padding: 2px 8px; border: 1px solid var(--border); border-radius: 6px; color: var(--text-2); }
  .gs__provs { display: grid; justify-items: end; font-family: var(--mono); font-size: 13px; font-weight: 400; }
  .gs__provs b { grid-area: 1 / 1; display: inline-flex; align-items: center; gap: 8px; font-weight: 400; opacity: 0; transition: opacity 250ms var(--ease); }
  .gs__link { width: 1px; height: 20px; margin: 0 auto; background: var(--border-strong); }
  .gs__infra { display: grid; }
  .gs__v { grid-area: 1 / 1; display: grid; gap: 10px; opacity: 0; transition: opacity 250ms var(--ease); }
  .gs__v--3 { grid-template-columns: repeat(3, 1fr); }
  .gs__v--2 { grid-template-columns: repeat(2, 1fr); }
  [data-step="0"] [data-v="0"], [data-step="1"] [data-v="1"], [data-step="2"] [data-v="2"] { opacity: 1; }
  .gs__box { display: grid; gap: 10px; align-content: start; padding: 12px; border: 1px dashed var(--border-strong); border-radius: var(--radius); min-height: 112px; }
  .gs__label { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 12px; color: var(--text-2); }
  .gs__pods { display: flex; gap: 6px; flex-wrap: wrap; }
  .gs__pods i { width: 22px; height: 22px; border-radius: 5px; background: var(--text); opacity: 0.85; }
  .gs__pods i:nth-child(even) { background: transparent; border: 1px solid var(--text-2); opacity: 1; }
  .gs__kubectl { justify-self: start; font-family: var(--mono); font-size: 11.5px; padding: 1px 6px; border: 1px solid var(--border-strong); border-radius: 5px; }
  @media (max-width: 900px) {
    .gs { grid-template-columns: minmax(0, 1fr); }
    .gs__stage { order: -1; }
  }
  @media (max-width: 480px) { .gs__v--3 { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-gs]").forEach((gs) => {
    const buttons = [...gs.querySelectorAll<HTMLButtonElement>(".gs__step")];
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        gs.dataset.step = b.dataset.i;
        buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      }),
    );
  });
</script>
