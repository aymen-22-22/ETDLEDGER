---
// ETDLedger mark: a ledger with one highlighted line in vermilion.
interface Props { word?: boolean; size?: number }
const { word = true, size = 22 } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 22 22" aria-hidden="true">
    <rect x="0.5" y="0.5" width="21" height="21" rx="5" fill="none" stroke="currentColor" />
    <line x1="5" y1="7" x2="17" y2="7" stroke="currentColor" />
    <line x1="5" y1="11" x2="12" y2="11" stroke="var(--brand-red)" stroke-width="2" />
    <line x1="5" y1="15" x2="17" y2="15" stroke="currentColor" />
  </svg>
  {word && <span class="logo__word">ETDLedger</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--text); }
  .logo__word { font-size: 17px; font-weight: 600; letter-spacing: -0.02em; }
</style>
