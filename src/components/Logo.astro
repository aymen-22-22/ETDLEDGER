---
interface Props { inverted?: boolean }
const { inverted = false } = Astro.props;
---
<span class:list={["logo", { "logo--inv": inverted }]}>
  <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
    <rect x="0.5" y="0.5" width="21" height="21" rx="1.5" fill="none" stroke="currentColor" />
    <line x1="5" y1="7" x2="17" y2="7" stroke="currentColor" />
    <line x1="5" y1="11" x2="12" y2="11" stroke="#E5482A" stroke-width="2" />
    <line x1="5" y1="15" x2="17" y2="15" stroke="currentColor" />
  </svg>
  <span class="logo__word">ETD<span>Ledger</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .logo--inv { color: var(--night-ink); }
  .logo__word { font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
  .logo__word span { font-weight: 400; }
</style>
