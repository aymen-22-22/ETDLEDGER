---
// Renders an architecture diagram as SVG: zones (dashed boundaries), nodes (boxes with an icon)
// and links (orthogonal lines). Links with `flow` carry small packets that move along them.
// Packets stop when the diagram is off screen and are hidden when the visitor prefers reduced motion.
import * as icons from "lucide-static";
import * as simple from "simple-icons";

export type Tone = "default" | "ok" | "bad" | "muted";
export interface Zone { x: number; y: number; w: number; h: number; label: string; tone?: Tone }
export interface Node {
  id: string; x: number; y: number; w?: number; h?: number;
  label: string; sub?: string; icon?: keyof typeof icons; tone?: Tone; dashed?: boolean; cls?: string;
}
export interface Link {
  from: string; to: string; via?: [number, number][]; vertical?: boolean;
  flow?: number; dur?: number; begin?: number; reverse?: boolean;
  dashed?: boolean; tone?: Tone; label?: string; labelAt?: [number, number]; cls?: string;
}
interface Props {
  width: number; height: number; label: string; caption?: string;
  zones?: Zone[]; nodes: Node[]; links?: Link[]; minWidth?: number;
}
const { width, height, label, caption, zones = [], nodes, links = [], minWidth = 640 } = Astro.props;

const W = 150, H = 52;
const byId = new Map(nodes.map((n) => [n.id, { ...n, w: n.w ?? W, h: n.h ?? H }]));
const center = (id: string) => {
  const n = byId.get(id);
  if (!n) throw new Error(`Topology: unknown node "${id}"`);
  return [n.x + n.w / 2, n.y + n.h / 2] as const;
};
const pathFor = (l: Link) => {
  const [ax, ay] = center(l.from);
  const [bx, by] = center(l.to);
  if (l.via) return `M${ax} ${ay} ${l.via.map(([x, y]) => `L${x} ${y}`).join(" ")} L${bx} ${by}`;
  const vertical = l.vertical ?? Math.abs(by - ay) > Math.abs(bx - ax);
  if (vertical) { const my = (ay + by) / 2; return `M${ax} ${ay} V${my} H${bx} V${by}`; }
  const mx = (ax + bx) / 2;
  return `M${ax} ${ay} H${mx} V${by} H${bx}`;
};
const labelPos = (l: Link) => {
  if (l.labelAt) return l.labelAt;
  const [ax, ay] = center(l.from);
  const [bx, by] = center(l.to);
  return [(ax + bx) / 2, (ay + by) / 2 - 8] as const;
};
// Nodes whose label names a real product show that product's logo in its brand color.
const logos: Record<string, string> = {
  PostgreSQL: "siPostgresql", Redis: "siRedis", Traefik: "siTraefikproxy", "SAP S/4HANA": "siSap", Odoo: "siOdoo",
  "Message queue": "siRabbitmq", Kubernetes: "siKubernetes", Docker: "siDocker", Grafana: "siGrafana",
};
const brandLogo = (label: string, x: number, y: number) => {
  const key = logos[label];
  if (!key) return null;
  const si = (simple as Record<string, { path: string; hex: string }>)[key];
  return `<svg x="${x}" y="${y}" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="topo__logo" style="--bc:#${si.hex}"><path d="${si.path}" fill="currentColor"/></svg>`;
};
// Other icons are colored by what they represent.
const kinds: [string, string[]][] = [
  ["data", ["Database", "Archive", "Warehouse", "FileSpreadsheet", "Inbox"]],
  ["sec", ["ShieldCheck", "BrickWall", "Radar", "BellRing", "Fingerprint", "KeyRound", "Eye", "ScrollText", "UserCheck"]],
  ["app", ["AppWindow", "Boxes", "LayoutGrid", "ShoppingCart", "CreditCard", "ClipboardList", "Handshake", "MessagesSquare"]],
  ["net", ["Globe", "Route", "Split", "Workflow", "Radio", "Network"]],
  ["host", ["Server", "Terminal", "LayoutDashboard", "Activity", "Building2", "Users", "Zap"]],
];
const kindOf = (name: string) => kinds.find(([, list]) => list.includes(name))?.[0] ?? "host";
const icon = (name: keyof typeof icons, x: number, y: number) =>
  String(icons[name])
    .replace(/width="24"/, 'width="16"').replace(/height="24"/, 'height="16"')
    .replace(/stroke-width="2"/, 'stroke-width="1.6"')
    .replace("<svg", `<svg x="${x}" y="${y}" aria-hidden="true"`);
const rendered = links.map((l) => {
  const d = l.reverse
    ? pathFor({ ...l, from: l.to, to: l.from, via: l.via && [...l.via].reverse() })
    : pathFor(l);
  return { ...l, d };
});
---
<figure class="topo" data-topo>
  <div class="topo__scroll">
    <svg class="topo__svg" viewBox={`0 0 ${width} ${height}`} style={`min-width:${minWidth}px`} role="img" aria-label={label}>
      {zones.map((z) => (
        <g class:list={["topo__zone", z.tone && `t-${z.tone}`]}>
          <rect x={z.x} y={z.y} width={z.w} height={z.h} rx="12" />
          <text x={z.x + 14} y={z.y + 22}>{z.label}</text>
        </g>
      ))}
      {rendered.map((l) => (
        <g class:list={["topo__link", l.tone && `t-${l.tone}`, { "is-dashed": l.dashed }, l.cls]}>
          <path d={l.d} />
          {l.label && <text x={labelPos(l)[0]} y={labelPos(l)[1]} text-anchor="middle">{l.label}</text>}
          {Array.from({ length: l.flow ?? 0 }, (_, i) => (
            <circle class="topo__pkt" r="3.5">
              <animateMotion dur={`${l.dur ?? 3}s`} begin={`${(l.begin ?? 0) + (i * (l.dur ?? 3)) / (l.flow ?? 1)}s`} repeatCount="indefinite" path={l.d} />
            </circle>
          ))}
        </g>
      ))}
      {[...byId.values()].map((n) => (
        <g class:list={["topo__node", n.tone && `t-${n.tone}`, { "is-dashed": n.dashed }, n.cls]}>
          <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="8" />
          {n.icon && <g class={`topo__ic k-${kindOf(n.icon)}`}><Fragment set:html={brandLogo(n.label, n.x + 12, n.y + n.h / 2 - 8) ?? icon(n.icon, n.x + 12, n.y + n.h / 2 - 8)} /></g>}
          <text class="topo__label" x={n.x + (n.icon ? 36 : 12)} y={n.sub ? n.y + n.h / 2 - 3 : n.y + n.h / 2 + 4.5}>{n.label}</text>
          {n.sub && <text class="topo__sub" x={n.x + (n.icon ? 36 : 12)} y={n.y + n.h / 2 + 13}>{n.sub}</text>}
        </g>
      ))}
      <slot />
    </svg>
  </div>
  {caption && <figcaption class="topo__cap">{caption}</figcaption>}
</figure>

<style is:global>
  .topo { margin: 0; min-width: 0; }
  .topo__scroll {
    overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-lg);
    background: var(--surface); box-shadow: var(--shadow);
    background-image: radial-gradient(var(--border) 1px, transparent 1px); background-size: 20px 20px;
  }
  .topo__svg { display: block; width: 100%; height: auto; font-family: var(--sans); }
  .topo__zone rect { fill: none; stroke: var(--border-strong); stroke-dasharray: 5 5; }
  .topo__zone text { font-size: 12px; fill: var(--text-2); font-family: var(--mono); }
  .topo__link path { fill: none; stroke: var(--border-strong); stroke-width: 1.5; }
  .topo__link text { font-size: 11px; fill: var(--text-3); font-family: var(--mono); paint-order: stroke; stroke: var(--surface); stroke-width: 4px; }
  .topo__link.is-dashed path { stroke-dasharray: 4 4; }
  .topo__pkt { fill: var(--text); }
  .topo__node rect { fill: var(--bg); stroke: var(--border-strong); }
  .topo__node.is-dashed rect { stroke-dasharray: 4 3; }
  .topo__node svg { color: var(--text); }
  .topo__ic.k-data svg { color: #3b82f6; }
  .topo__ic.k-sec svg { color: var(--brand-red); }
  .topo__ic.k-app svg { color: #22c55e; }
  .topo__ic.k-net svg { color: #a855f7; }
  .topo__ic.k-host svg { color: #f59e0b; }
  .topo__ic svg.topo__logo { color: var(--bc); }
  :root[data-theme="dark"] .topo__ic svg.topo__logo { filter: brightness(1.5); }
  .topo__label { font-size: 13px; font-weight: 500; fill: var(--text); }
  .topo__sub { font-size: 11.5px; fill: var(--text-2); }
  .t-ok.topo__node rect, .t-ok.topo__zone rect { stroke: var(--green); }
  .t-ok .topo__pkt, .t-ok.topo__pkt { fill: var(--green); }
  .t-ok.topo__link path { stroke: var(--green); }
  .t-bad.topo__node rect, .t-bad.topo__zone rect, .t-bad.topo__link path { stroke: var(--red); }
  .t-bad .topo__pkt, .t-bad.topo__pkt { fill: var(--red); }
  .t-bad.topo__zone text, .t-bad.topo__link text { fill: var(--red-text); }
  .t-muted.topo__node { opacity: 0.6; }
  .topo__cap { margin-top: 12px; font-size: 13px; color: var(--text-3); text-align: center; }
  @media (prefers-reduced-motion: reduce) { .topo__pkt { display: none; } }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      const svg = e.target.querySelector("svg.topo__svg") as SVGSVGElement | null;
      if (!svg) continue;
      e.isIntersecting ? svg.unpauseAnimations() : svg.pauseAnimations();
    }
  });
  document.querySelectorAll("[data-topo]").forEach((el) => io.observe(el));
</script>
