---
import DeployMock from "./ui/DeployMock.astro";
import DataMock from "./ui/DataMock.astro";
import NetworkMock from "./ui/NetworkMock.astro";
import ObserveMock from "./ui/ObserveMock.astro";
import Icon from "./Icon.astro";

const tabs = [
  { id: "deploy", icon: "Rocket", label: "Deploy", title: "Push code, get a running service", points: ["Deploy from Git or any container image", "Automatic HTTPS for every app", "Replicas with health checks", "A preview environment per branch"] },
  { id: "data", icon: "Database", label: "Data", title: "Databases in a few clicks", points: ["PostgreSQL, MySQL, MariaDB and Redis", "S3-compatible storage and RabbitMQ", "Scheduled backups with restore", "Isolated in each project's network"] },
  { id: "network", icon: "Network", label: "Network", title: "Routing without config files", points: ["Path routing, redirects and rate limits", "IP allow-lists and basic auth", "DNS zones for your own domains", "A private network per project"] },
  { id: "observe", icon: "Activity", label: "Observe", title: "See what's running and what changed", points: ["CPU, memory, request and error rates", "Searchable logs for every service", "Alerts to Slack, email or webhooks", "Deploys marked on every chart"] },
] as const;
---
<div class="tour" data-tour>
  <div class="tour__tabs" role="tablist" aria-label="Product features">
    {tabs.map((t, i) => (
      <button class="tour__tab" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} type="button"><Icon name={t.icon} size={16} />{t.label}</button>
    ))}
  </div>
  {tabs.map((t, i) => (
    <div class="tour__panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
      <div class="tour__copy">
        <h3 class="h3">{t.title}</h3>
        <ul class="checklist">{t.points.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="tour__ui">
        {t.id === "deploy" && <DeployMock />}
        {t.id === "data" && <DataMock />}
        {t.id === "network" && <NetworkMock />}
        {t.id === "observe" && <ObserveMock />}
      </div>
    </div>
  ))}
</div>

<style>
  .tour__tabs {
    display: inline-flex; gap: 4px; padding: 4px; margin-bottom: 32px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    max-width: 100%; overflow-x: auto;
  }
  .tour__tab {
    display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 16px; border-radius: 7px; font-size: 15px; font-weight: 500; color: var(--text-2);
    transition: color 150ms var(--ease), background-color 150ms var(--ease);
  }
  .tour__tab:hover { color: var(--text); }
  .tour__tab[aria-selected="true"] { background: var(--bg); color: var(--text); box-shadow: 0 0 0 1px var(--border); }
  .tour__panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 48px; align-items: center; }
  .tour__panel[hidden] { display: none; }
  .tour__copy { display: grid; gap: 20px; }
  .tour__panel:not([hidden]) .tour__ui { animation: tour-in 300ms var(--ease); }
  @keyframes tour-in { from { opacity: 0; transform: translateY(6px); } }
  @media (max-width: 900px) { .tour__panel { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-tour]").forEach((tour) => {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls")!);
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (e.key === "Home") return select(tabs[0], true);
        if (e.key === "End") return select(tabs[tabs.length - 1], true);
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });
  });
</script>
