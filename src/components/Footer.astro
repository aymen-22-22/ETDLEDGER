---
import { u } from "../lib/url";
import Logo from "./Logo.astro";
import { site } from "../lib/site";

const cols = [
  { title: "Product", links: [["Overview", "/product"], ["Docs", "/docs"], ["Pricing", "/pricing"], ["Security", "/security"]] },
  { title: "Services", links: [["Security services", "/services#security"], ["Cyber labs", "/labs"], ["SAP", "/services#sap"], ["Oracle", "/services#oracle"], ["Odoo", "/services#odoo"], ["Managed Kubernetes", "/services#kubernetes"]] },
  { title: "Company", links: [["About", "/company"], ["Contact", "/contact"]] },
  { title: "Legal", links: [["Privacy policy", "/legal/privacy"], ["Terms of use", "/legal/terms"]] },
];
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__brand">
        <Logo />
        <p class="small muted">The self-hosted cloud platform, from ETDLedger.</p>
        <address class="small muted">
          {site.city}<br />
          <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      </div>
      {cols.map((c) => (
        <div class="ftr__col">
          <p class="ftr__title">{c.title}</p>
          <ul>
            {c.links.map(([label, href]) => <li><a href={u(href)}>{label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="ftr__base">
      <span>© {year} ETDLedger. All rights reserved.</span>
      <span>InfraLedger is a product of ETDLedger.</span>
    </div>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--border); background: var(--bg-subtle); padding: 64px 0 32px; }
  .ftr__top { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: 32px; padding-bottom: 48px; }
  .ftr__brand { display: grid; gap: 14px; align-content: start; }
  .ftr__brand address { font-style: normal; line-height: 1.7; }
  .ftr__title { font-size: 14px; font-weight: 600; margin-bottom: 14px; }
  .ftr__col ul { display: grid; gap: 10px; font-size: 15px; color: var(--text-2); }
  .ftr__col a { transition: color 150ms var(--ease); }
  .ftr__col a:hover { color: var(--text); }
  .ftr__base {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding-top: 24px; border-top: 1px solid var(--border); font-size: 13.5px; color: var(--text-2);
  }
  @media (max-width: 900px) {
    .ftr__top { grid-template-columns: repeat(2, 1fr); }
    .ftr__brand { grid-column: 1 / -1; }
  }
</style>
