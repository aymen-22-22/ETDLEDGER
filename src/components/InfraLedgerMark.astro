---
// InfraLedger mark: stacked layers on a petrol tile.
interface Props { size?: number; tone?: "petrol" | "mono" }
const { size = 20, tone = "petrol" } = Astro.props;
const [bg, ink] = tone === "petrol" ? ["#3fb6c4", "#061316"] : ["#e4e9ef", "#0e1215"];
---
<svg width={size} height={size} viewBox="0 0 20 20" aria-hidden="true">
  <rect x="1" y="1" width="18" height="18" rx="4" fill={bg} />
  <path d="M10 4.2 15.6 7 10 9.8 4.4 7Z" fill={ink} />
  <path d="M4.4 10.1 10 12.9l5.6-2.8M4.4 13.2 10 16l5.6-2.8" fill="none" stroke={ink} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
