---
// Page header. With `brand`, it becomes a colored band in that product's theme with its mark on the right.
import BrandLogo from "./BrandLogo.astro";
import Icon from "./Icon.astro";
import type { Brand } from "../lib/brands";
interface Props { eyebrow: string; title: string; lead: string; brand?: Brand }
const { eyebrow, title, lead, brand } = Astro.props;
---
<section class:list={["ph", { "ph--brand": brand }]}>
  <div class="container ph__in">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h1 ph__title">{title}</h1>
      <p class="lead ph__lead">{lead}</p>
      <div class="ph__actions"><slot /></div>
    </div>
    {brand && (
      <div class="ph__mark" aria-hidden="true">
        {brand === "sap" && <BrandLogo brand="siSap" size={120} decorative />}
        {brand === "odoo" && <BrandLogo brand="siOdoo" size={120} decorative />}
        {brand === "oracle" && <span class="ph__word">ORACLE</span>}
        {brand === "labs" && <Icon name="FlaskConical" size={96} />}
        {brand === "infraledger" && (
          <svg width="96" height="96" viewBox="0 0 22 22"><rect x="0.75" y="0.75" width="20.5" height="20.5" rx="5" fill="none" stroke="currentColor" stroke-width="1.2" /><path d="M6 7.5h10M6 11h6M6 14.5h10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .ph { padding: 96px 0 72px; border-bottom: 1px solid var(--border); }
  .ph__in { display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; align-items: center; }
  .ph__title { margin-top: 16px; max-width: 20ch; }
  .ph__lead { margin-top: 20px; max-width: 640px; }
  .ph__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .ph__actions:empty { display: none; }

  .ph--brand {
    position: relative; color: #fff; border-bottom: 0;
    background: radial-gradient(120% 140% at 100% 0%, var(--hero-b), var(--hero-a) 70%);
  }
  .ph--brand::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: var(--accent-2); }
  .ph--brand .ph__in { grid-template-columns: minmax(0, 1fr) auto; }
  .ph--brand .eyebrow { color: rgba(255, 255, 255, 0.78); }
  .ph--brand .lead { color: rgba(255, 255, 255, 0.86); }
  .ph--brand :global(.btn--primary) { background: #fff; color: var(--hero-a); }
  .ph--brand :global(.btn--primary:hover) { background: rgba(255, 255, 255, 0.88); }
  .ph--brand :global(.btn--secondary) { border-color: rgba(255, 255, 255, 0.4); color: #fff; }
  .ph--brand :global(.btn--secondary:hover) { background: rgba(255, 255, 255, 0.1); }
  .ph__mark {
    display: grid; place-items: center; width: 220px; height: 220px; color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 24px; background: rgba(255, 255, 255, 0.06);
  }
  .ph__word { font-size: 34px; font-weight: 700; letter-spacing: 0.12em; }
  @media (max-width: 1000px) {
    .ph { padding: 72px 0 56px; }
    .ph--brand .ph__in { grid-template-columns: minmax(0, 1fr); }
    .ph__mark { display: none; }
  }
</style>
