---
// Page header. Product pages pass `brand`: a solid line in the product color across the top and the
// product's logo beside the label. A `visual` slot puts the real product screen on the right.
import BrandLogo from "./BrandLogo.astro";
import InfraLedgerMark from "./InfraLedgerMark.astro";
import type { Brand } from "../lib/brands";
interface Props { eyebrow: string; title: string; lead: string; brand?: Brand; stack?: boolean }
// `stack` puts a wide visual (like a dashboard) under the copy instead of beside it.
const { eyebrow, title, lead, brand, stack = false } = Astro.props;
const hasVisual = Astro.slots.has("visual");
---
<section class:list={["ph", { "ph--brand": brand, "ph--split": hasVisual && !stack, "ph--stack": hasVisual && stack }]}>
  <div class="container ph__in">
    <div class="ph__copy">
      <p class="ph__eyebrow">
        {brand === "sap" && <BrandLogo brand="siSap" size={30} decorative />}
        {brand === "odoo" && <BrandLogo brand="siOdoo" size={38} decorative />}
        {brand === "oracle" && <span class="ph__word">ORACLE</span>}
        {brand === "infraledger" && <InfraLedgerMark size={22} />}
        <span>{eyebrow}</span>
      </p>
      <h1 class="h1 ph__title">{title}</h1>
      <p class="lead ph__lead">{lead}</p>
      <div class="ph__actions"><slot /></div>
    </div>
    {hasVisual && <div class="ph__visual"><slot name="visual" /></div>}
  </div>
</section>

<style>
  .ph { position: relative; padding: 96px 0 80px; border-bottom: 1px solid var(--border); }
  .ph--brand::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: var(--accent); }
  .ph__in { display: grid; grid-template-columns: minmax(0, 1fr); gap: 56px; align-items: center; }
  .ph--split .ph__in { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); }
  .ph--split .ph__title { font-size: clamp(36px, 4.4vw, 54px); }
  .ph__eyebrow { display: flex; align-items: center; gap: 12px; min-height: 30px; font-size: 14px; font-weight: 500; color: var(--text-2); }
  .ph__word { font-size: 17px; font-weight: 700; letter-spacing: 0.14em; color: #c74634; }
  :root[data-theme="dark"] .ph__word { color: #f08a7a; }
  .ph__title { margin-top: 16px; max-width: 20ch; }
  .ph__lead { margin-top: 20px; max-width: 620px; }
  .ph__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .ph__actions:empty { display: none; }
  .ph__visual { min-width: 0; }
  .ph--stack .ph__in { gap: 56px; }
  .ph--stack .ph__visual { max-width: 1040px; }
  @media (max-width: 1000px) {
    .ph { padding: 72px 0 56px; }
    .ph--split .ph__in { grid-template-columns: minmax(0, 1fr); gap: 40px; }
  }
</style>
