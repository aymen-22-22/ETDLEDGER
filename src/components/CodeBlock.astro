---
interface Props { title?: string; lines: string[] }
const { title = "Terminal", lines } = Astro.props;
---
<div class="code">
  <div class="code__bar">
    <span>{title}</span>
    <button class="copy" type="button" data-copy aria-label="Copy commands">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="4.5" y="4.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M9.5 2.5V2A1.5 1.5 0 0 0 8 .5H3A1.5 1.5 0 0 0 1.5 2v5A1.5 1.5 0 0 0 3 8.5h.5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
      <span>Copy</span>
    </button>
  </div>
  <pre><code>{lines.map((l) => (l.startsWith("#") ? <span class="c">{l + "\n"}</span> : l + "\n"))}</code></pre>
</div>
