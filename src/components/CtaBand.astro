---
import { u } from "../lib/url";
interface Props { title: string; text: string; interest?: string; action?: string }
const { title, text, interest = "platform", action = "Contact us" } = Astro.props;
---
<section class="cta">
  <div class="container">
    <div class="cta__panel" data-reveal>
      <div>
        <h2 class="h2">{title}</h2>
        <p class="lead cta__text">{text}</p>
      </div>
      <a class="btn btn--primary" href={u(`/contact?interest=${interest}`)}>{action} <span class="arrow">→</span></a>
    </div>
  </div>
</section>

<style>
  .cta { padding: 96px 0; border-top: 1px solid var(--border); }
  .cta__panel { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
  .cta__text { margin-top: 12px; max-width: 560px; }
</style>
