---
import * as icons from "lucide-static";

interface Props { name: keyof typeof icons; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const svg = String(icons[name])
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, 'stroke-width="1.6"')
  .replace("<svg", '<svg aria-hidden="true" focusable="false"');
---
<span class:list={["icon", cls]} set:html={svg} />

<style>
  .icon { display: inline-flex; flex-shrink: 0; line-height: 0; }
</style>
