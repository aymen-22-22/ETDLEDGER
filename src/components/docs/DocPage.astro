---
// A paper document page (white in both themes, like a printed report), with two sheets behind it
// to show it's a multi-page document. Every preview is labelled "Sample".
import Logo from "../Logo.astro";
interface Props { kind: string; caption?: string }
const { kind, caption } = Astro.props;
---
<figure class="doc">
  <div class="doc__stack">
    <div class="doc__page">
      <div class="doc__head">
        <span class="doc__brand"><Logo size={18} /></span>
        <span class="doc__kind">{kind}</span>
        <span class="doc__tag">Sample</span>
      </div>
      <slot />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  .doc { margin: 0; min-width: 0; }
  .doc__stack { position: relative; padding: 0 12px 12px 0; }
  .doc__stack::before, .doc__stack::after {
    content: ""; position: absolute; border-radius: 6px; background: #f3f2ee; border: 1px solid rgba(20, 23, 28, 0.08);
  }
  .doc__stack::before { inset: 12px 0 0 12px; }
  .doc__stack::after { inset: 6px 6px 6px 6px; background: #f8f7f4; }
  .doc__page {
    position: relative; z-index: 1; padding: 26px 28px 28px; border-radius: 6px;
    background: #fff; color: #14171c; box-shadow: 0 1px 2px rgba(20, 23, 28, 0.06), 0 20px 40px -24px rgba(20, 23, 28, 0.35);
    font-size: 12.5px; line-height: 1.5;
    --ink-2: #4b5160; --ink-3: #868b96; --rule: #e6e4de; --red: #e5482a;
  }
  .doc__head { display: flex; align-items: center; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid var(--rule); }
  .doc .doc__brand .logo { color: #14171c; --brand-red: #e5482a; }
  .doc .doc__brand .logo__word { font-size: 13px; }
  .doc__kind { color: var(--ink-3); font-size: 12px; }
  .doc__tag { margin-left: auto; padding: 2px 8px; border: 1px solid var(--rule); border-radius: 999px; font-size: 11px; color: var(--ink-3); }
  .doc__title { margin-top: 18px; font-size: 18px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .doc__meta { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 8px; color: var(--ink-2); font-size: 12px; }
  .doc__meta b { font-weight: 500; color: #14171c; }
  .doc__h { margin-top: 20px; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  .doc__p { margin-top: 6px; color: var(--ink-2); }
  .doc figcaption, .doc + figcaption { margin-top: 12px; font-size: 13px; color: var(--text-3); }
</style>
