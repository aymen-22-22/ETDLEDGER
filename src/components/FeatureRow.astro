---
import Icon from "./Icon.astro";
import BrandLogo from "./BrandLogo.astro";
interface Props {
  id: string; eyebrow: string; title: string; text: string; items: string[]; note?: string;
  icon?: Parameters<typeof Icon>[0]["name"];
  brand?: Parameters<typeof BrandLogo>[0]["brand"];
  subtle?: boolean;
}
const solo = !Astro.slots.has("default");
const { id, eyebrow, title, text, items, note, icon, brand, subtle = false } = Astro.props;
---
<section class:list={["section fr", { "section--subtle": subtle }]} id={id}>
  <div class:list={["container fr__in", { "fr__in--solo": solo }]}>
    <div class="fr__copy" data-reveal>
      <p class="eyebrow fr__eyebrow">{brand && <span class="fr__icon"><BrandLogo brand={brand} size={20} decorative /></span>}{!brand && icon && <span class="fr__icon"><Icon name={icon} size={16} /></span>}{eyebrow}</p>
      <h2 class="h2 fr__title">{title}</h2>
      <p class="lead">{text}</p>
      <ul class="checklist">{items.map((i) => <li>{i}</li>)}</ul>
      {note && <p class="fr__note">{note}</p>}
    </div>
    {!solo && <div class="fr__ui" data-reveal><slot /></div>}
  </div>
</section>

<style>
  .fr__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 64px; align-items: center; }
  .fr__in--solo { grid-template-columns: minmax(0, 760px); }
  .fr__copy { display: grid; gap: 18px; align-content: start; }
  .fr__eyebrow { display: inline-flex; align-items: center; gap: 10px; }
  .fr__icon { display: inline-grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--border); border-radius: 8px; color: var(--text); background: var(--surface); }
  .fr__title { font-size: clamp(28px, 3.2vw, 40px); }
  .fr__note { font-size: 14px; color: var(--text-2); padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .fr__ui:empty { display: none; }
  @media (max-width: 900px) { .fr__in { grid-template-columns: minmax(0, 1fr); gap: 40px; } }
</style>
