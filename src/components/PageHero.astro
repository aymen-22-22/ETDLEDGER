---
interface Props {
  label: string;
  title: string;
  lead: string;
  index: { num: string; label: string; href: string }[];
}
const { label, title, lead, index } = Astro.props;
---
<section class="phero">
  <div class="phero__bg" aria-hidden="true"></div>
  <div class="wrap">
    <div class="grid phero__in">
      <p class="phero__label" data-phero-in><span class="phero__dot"></span><span class="mono">{label}</span></p>
      <h1 class="display phero__title" data-phero-in>{title}</h1>
      <p class="lead phero__lead" data-phero-in>{lead}</p>
      <nav class="phero__idx card" aria-label="On this page" data-phero-in>
        <p class="label">On this page</p>
        <ol>
          {index.map((i) => (
            <li><a href={i.href}><span class="mono">§{i.num}</span><span>{i.label}</span><span class="arrow">→</span></a></li>
          ))}
        </ol>
      </nav>
    </div>
  </div>
</section>

<style>
  .phero { position: relative; margin-top: -64px; padding: 168px 0 104px; overflow: hidden; }
  .phero__bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(800px 380px at 18% -60px, color-mix(in srgb, var(--signal) 16%, transparent), transparent 70%),
      repeating-linear-gradient(to bottom, transparent 0 47px, var(--rule-soft) 47px 48px);
    -webkit-mask: radial-gradient(1200px 600px at 30% 0, #000 30%, transparent 78%);
    mask: radial-gradient(1200px 600px at 30% 0, #000 30%, transparent 78%);
  }
  .phero__in { position: relative; row-gap: 28px; align-items: end; }
  .phero__label {
    grid-column: 1 / -1; justify-self: start;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 14px 6px 10px; border-radius: 999px;
    border: 1px solid var(--rule); background: color-mix(in srgb, var(--surface) 70%, transparent);
    font-size: 12px; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.04em;
  }
  .phero__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 10px var(--signal-glow); }
  .phero__title { grid-column: 1 / span 10; font-size: clamp(44px, 6vw, 84px); margin-top: 8px; }
  .phero__lead { grid-column: 1 / span 6; }
  .phero__idx { grid-column: 9 / span 4; grid-row: 3; padding: 18px 20px 8px; }
  .phero__idx ol { list-style: none; margin-top: 10px; }
  .phero__idx li + li { border-top: 1px solid var(--rule-soft); }
  .phero__idx a {
    display: grid; grid-template-columns: 32px 1fr auto; align-items: center;
    padding: 11px 0; font-size: 15px; color: var(--ink-2);
    transition: color 200ms var(--ease);
  }
  .phero__idx a:hover { color: var(--ink); }
  .phero__idx .mono { font-size: 12px; color: var(--signal); }
  .phero__idx .arrow { color: var(--ink-3); transition: transform 200ms var(--ease), color 200ms var(--ease); }
  .phero__idx a:hover .arrow { transform: translateX(3px); color: var(--ink); }
  @media (max-width: 1000px) {
    .phero__title, .phero__lead, .phero__idx { grid-column: 1 / -1; }
    .phero__idx { grid-row: auto; }
  }
</style>

<script>
  import { gsap } from "gsap";
  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    gsap.from("[data-phero-in]", { y: 18, opacity: 0, duration: 0.9, ease: "power3.out", stagger: 0.08 });
  });
</script>
