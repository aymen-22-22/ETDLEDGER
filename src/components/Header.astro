---
import { u, stripBase } from "../lib/url";
import Logo from "./Logo.astro";
import { brands, type Brand } from "../lib/brands";

interface Props { brand?: Brand }
const { brand } = Astro.props;
// The header button matches the page: a demo for the product, a conversation everywhere else.
const cta = brand === "infraledger"
  ? { label: "Request a demo", href: "/contact?interest=platform" }
  : { label: "Talk to us", href: brand ? `/contact?interest=${brand}` : "/contact" };

const links = [{ href: "/docs", label: "Docs" }];
const products = Object.values(brands);
const services = [
  { href: "/#platform", label: "Platform", text: "InfraLedger rollout, operation and managed Kubernetes" },
  { href: "/#security", label: "Security", text: "Detection, assessments and compliance" },
  { href: "/#enterprise", label: "Enterprise systems", text: "SAP, Oracle and Odoo" },
];
const path = stripBase(Astro.url.pathname).replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (path === href || path.startsWith(href + "/") ? "page" : undefined);
---
<header class="hdr" data-hdr>
  <div class="container hdr__in">
    <a class="hdr__logo" href={u("/")} aria-label="ETDLedger home"><Logo /></a>

    <nav class="hdr__nav" aria-label="Primary">
      <div class="dd" data-dd>
        <button class="hdr__link dd__btn" type="button" aria-expanded="false" aria-controls="dd-products" aria-current={products.some((p) => isCurrent(p.href)) ? "page" : undefined}>
          Products
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="dd__panel" id="dd-products">
          <p class="dd__group">Products and solutions</p>
          {products.map((p) => (
            <a class="dd__item dd__item--dot" href={u(p.href)} style={`--c:${p.color}`}>
              <span class="dd__title">{p.name}</span>
              <span class="dd__text">{p.text}</span>
            </a>
          ))}
        </div>
      </div>
      <div class="dd" data-dd>
        <button class="hdr__link dd__btn" type="button" aria-expanded="false" aria-controls="dd-services" aria-current={path === "/" ? "page" : undefined}>
          Services
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="dd__panel" id="dd-services">
          <p class="dd__group">Engineering services</p>
          {services.map((s) => (
            <a class="dd__item" href={u(s.href)}>
              <span class="dd__title">{s.label}</span>
              <span class="dd__text">{s.text}</span>
            </a>
          ))}
          <a class="dd__all" href={u("/")}>All services →</a>
        </div>
      </div>
      {links.map((l) => <a class="hdr__link" href={u(l.href)} aria-current={isCurrent(l.href)}>{l.label}</a>)}
      <a class="hdr__link" href={u("/company")} aria-current={isCurrent("/company")}>Company</a>
    </nav>

    <div class="hdr__actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch theme">
        <svg class="i-sun" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <svg class="i-moon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      </button>
      <a class="btn btn--primary btn--sm hdr__cta" href={u(cta.href)}>{cta.label}</a>
      <button class="icon-btn hdr__burger" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu" data-burger>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path class="b1" d="M3 6h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path class="b2" d="M3 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div class="mnav" id="mnav" hidden data-mnav>
    <nav class="container mnav__in" aria-label="Mobile">
      <p class="mnav__group">Products and solutions</p>
      {products.map((p) => <a class="mnav__sub mnav__sub--dot" href={u(p.href)} style={`--c:${p.color}`}>{p.name}</a>)}
      <p class="mnav__group">Services</p>
      {services.map((s) => <a class="mnav__sub" href={u(s.href)}>{s.label}</a>)}
      {links.map((l) => <a class="mnav__link" href={u(l.href)}>{l.label}</a>)}
      <a class="mnav__link" href={u("/company")}>Company</a>
      <a class="btn btn--primary mnav__cta" href={u(cta.href)}>{cta.label}</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: var(--header-bg);
    backdrop-filter: saturate(1.5) blur(12px);
    -webkit-backdrop-filter: saturate(1.5) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .hdr__in { height: 64px; display: flex; align-items: center; gap: 32px; }
  .hdr__logo { flex-shrink: 0; }
  .hdr__nav { display: flex; align-items: center; gap: 2px; flex: 1; }
  .hdr__link {
    display: inline-flex; align-items: center; gap: 6px;
    height: 34px; padding: 0 12px; border-radius: var(--radius);
    font-size: 15px; color: var(--text-2);
    transition: color 150ms var(--ease), background-color 150ms var(--ease);
  }
  .hdr__link:hover, .dd:hover .dd__btn, .dd__btn[aria-expanded="true"] { color: var(--text); background: var(--surface); }
  .hdr__link[aria-current] { color: var(--text); }
  .hdr__actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }

  .icon-btn {
    width: 34px; height: 34px; display: grid; place-items: center; border-radius: var(--radius);
    color: var(--text-2); transition: color 150ms var(--ease), background-color 150ms var(--ease);
  }
  .icon-btn:hover { color: var(--text); background: var(--surface); }
  .icon-btn svg { grid-area: 1 / 1; }
  :global([data-theme="dark"]) .i-moon, :global([data-theme="light"]) .i-sun { display: none; }

  .dd { position: relative; }
  .dd__btn svg { transition: transform 200ms var(--ease); }
  .dd__btn[aria-expanded="true"] svg { transform: rotate(180deg); }
  .dd__panel {
    position: absolute; top: calc(100% + 8px); left: -8px; width: 340px;
    padding: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity 150ms var(--ease), transform 150ms var(--ease), visibility 150ms;
  }
  .dd__panel::before { content: ""; position: absolute; left: 0; right: 0; top: -10px; height: 10px; }
  .dd.is-open .dd__panel { opacity: 1; visibility: visible; transform: none; }
  @media (hover: hover) and (pointer: fine) {
    .dd:hover .dd__panel { opacity: 1; visibility: visible; transform: none; }
  }
  .dd__item { display: grid; gap: 2px; padding: 10px 12px; border-radius: var(--radius); }
  .dd__item:hover { background: var(--surface-2); }
  .dd__title { font-size: 15px; font-weight: 500; }
  .dd__text { font-size: 13.5px; color: var(--text-2); }
  .dd__group { padding: 8px 12px 4px; font-size: 12.5px; color: var(--text-3); }
  .dd__item--dot .dd__title, .mnav__sub--dot { display: inline-flex; align-items: center; gap: 8px; }
  .dd__item--dot .dd__title::before, .mnav__sub--dot::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .dd__all { display: block; margin-top: 4px; padding: 10px 12px; border-top: 1px solid var(--border); font-size: 14px; color: var(--text-2); }
  .dd__all:hover { color: var(--text); }

  .hdr__burger { display: none; }
  .b1, .b2 { transition: transform 200ms var(--ease); transform-origin: center; }
  [aria-expanded="true"] .b1 { transform: translateY(3px) rotate(45deg); }
  [aria-expanded="true"] .b2 { transform: translateY(-3px) rotate(-45deg); }

  .mnav {
    position: fixed; inset: 64px 0 0; z-index: 49; overflow-y: auto;
    background: var(--bg); border-top: 1px solid var(--border);
  }
  .mnav__in { display: flex; flex-direction: column; padding-top: 16px; padding-bottom: 32px; }
  .mnav__link { padding: 14px 0; font-size: 20px; font-weight: 500; border-bottom: 1px solid var(--border); }
  .mnav__group { padding: 20px 0 6px; font-size: 14px; color: var(--text-2); }
  .mnav__sub { padding: 10px 0 10px 12px; font-size: 17px; color: var(--text-2); }
  .mnav__sub + .mnav__link { margin-top: 8px; border-top: 1px solid var(--border); }
  .mnav__cta { margin-top: 24px; height: 48px; }

  @media (max-width: 900px) {
    .hdr__nav, .hdr__cta { display: none; }
    .hdr__burger { display: grid; }
  }
</style>

<script>
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const label = () => toggle?.setAttribute("aria-label", `Switch to ${root.dataset.theme === "dark" ? "light" : "dark"} theme`);
  label();
  toggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    if (meta) meta.content = next === "light" ? "#ffffff" : "#0a0a0b";
    try { localStorage.setItem("theme", next); } catch {}
    label();
  });

  const dds = [...document.querySelectorAll<HTMLElement>("[data-dd]")];
  const setDd = (dd: HTMLElement, open: boolean) => {
    dd.classList.toggle("is-open", open);
    dd.querySelector(".dd__btn")?.setAttribute("aria-expanded", String(open));
  };
  dds.forEach((dd) => dd.querySelector(".dd__btn")?.addEventListener("click", () => {
    const open = !dd.classList.contains("is-open");
    dds.forEach((o) => setDd(o, false));
    setDd(dd, open);
  }));
  document.addEventListener("click", (e) => dds.forEach((dd) => { if (!dd.contains(e.target as Node)) setDd(dd, false); }));

  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const mnav = document.querySelector<HTMLElement>("[data-mnav]");
  const setMenu = (open: boolean) => {
    if (!burger || !mnav) return;
    mnav.hidden = !open;
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.style.overflow = open ? "hidden" : "";
  };
  burger?.addEventListener("click", () => setMenu(mnav?.hidden ?? false));
  mnav?.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) setMenu(false); });
  window.matchMedia("(min-width: 901px)").addEventListener("change", (e) => { if (e.matches) setMenu(false); });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const open = dds.find((dd) => dd.classList.contains("is-open"));
    if (open) { setDd(open, false); open.querySelector<HTMLButtonElement>(".dd__btn")?.focus(); }
    if (mnav && !mnav.hidden) { setMenu(false); burger?.focus(); }
  });
</script>
