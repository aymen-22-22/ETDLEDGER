---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import PageHeader from "../components/PageHeader.astro";
import FeatureRow from "../components/FeatureRow.astro";
import CtaBand from "../components/CtaBand.astro";
import LogoCloud from "../components/LogoCloud.astro";
import SapLaunchpad from "../components/ui/SapLaunchpad.astro";
import TrademarkNote from "../components/TrademarkNote.astro";
import SapFlow from "../components/diagrams/SapFlow.astro";

const offers = [["Implementation", "Rollout of SAP modules aligned to your processes, in stages."], ["Migration", "Version and hosting moves with a cutover plan and a tested rollback."], ["Integration", "APIs, events and data flows between SAP and your other systems."], ["Administration", "Monitoring, patching, user and change management."], ["Hosting around SAP", "The services around SAP run on InfraLedger, on servers you control."], ["Support", "A team that knows your landscape, for incidents and continuous change."]];
const ld = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "SAP implementation and integration",
  description: "SAP implementation, migration, integration and administration by ETDLedger's engineers.",
  url: "https://etdledger.com/sap",
  provider: { "@id": "https://etdledger.com/#organization" },
  areaServed: "DZ",
};
---
<Base brand="sap" jsonld={[ld]} title="SAP — ETDLedger" description="SAP implementation, migration, integration and administration by ETDLedger's engineers.">
  <PageHeader brand="sap" eyebrow="SAP solutions" title="SAP, connected to the rest of your business" lead="We implement, migrate and integrate SAP landscapes, and connect them to the web apps, data and partners around them.">
    <a class="btn btn--primary" href={u("/contact?interest=sap")}>Talk to an SAP engineer <span class="arrow">→</span></a>
    <a class="btn btn--secondary" href="#how">How it works</a>
  </PageHeader>

  <FeatureRow id="how" eyebrow="Integration" icon="Workflow" title="One integration layer, not a web of point-to-point links" text="We connect SAP to your other systems through APIs, events and mappings you can monitor and change safely." items={["Order, stock and finance data shared with web and mobile apps", "Reporting feeds into your data warehouse", "Events published to a message queue", "Partner and bank connections"]}>
    <SapFlow />
  </FeatureRow>

  <section class="section section--subtle">
    <div class="container wwd">
      <div data-reveal>
        <p class="eyebrow">What we do</p>
        <h2 class="h2 wwd__title">SAP work, from rollout to operations</h2>
        <dl class="wwd__list">
          {offers.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
        </dl>
      </div>
      <div data-reveal><SapLaunchpad /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <LogoCloud label="Systems we connect SAP with" items={[["siSap", "SAP"], ["siApachekafka", "Kafka"], ["siRabbitmq", "RabbitMQ"], ["siPostgresql", "PostgreSQL"], ["siRedhat", "Red Hat"], ["siSuse", "SUSE"], ["siPython", "Python"]]} />
    </div>
  </section>

  <CtaBand title="Tell us about your SAP landscape" text="Which modules you run, where they are hosted and what needs to connect." interest="sap" action="Talk to an SAP engineer" />
  <TrademarkNote text="SAP and S/4HANA are trademarks of SAP SE. ETDLedger is an independent service provider and is not affiliated with SAP SE." />
</Base>

<style>
  .wwd { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; align-items: start; }
  .wwd__title { margin: 12px 0 32px; }
  .wwd__list { border-top: 1px solid var(--border); }
  .wwd__list div { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--border); }
  .wwd__list dt { font-weight: 600; }
  .wwd__list dd { color: var(--text-2); font-size: 15px; }
  @media (max-width: 960px) { .wwd { grid-template-columns: minmax(0, 1fr); gap: 48px; } }
  @media (max-width: 560px) { .wwd__list div { grid-template-columns: minmax(0, 1fr); gap: 4px; } }
</style>
