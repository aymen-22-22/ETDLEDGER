---
import Base from "../layouts/Base.astro";

const email = "hello@etdledger.com";
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const interests = [
  ["platform", "InfraLedger platform"],
  ["kubernetes", "Managed Kubernetes"],
  ["security", "Security services"],
  ["sap", "SAP"],
  ["oracle", "Oracle"],
  ["other", "Something else"],
];
const sizes = ["1 server", "2–10 servers", "11–50 servers", "50+ servers or a Kubernetes cluster", "Not sure yet"];
---
<Base title="Contact — ETDLedger" description="Request an InfraLedger demo or talk to ETDLedger about security, SAP, Oracle and managed Kubernetes.">
  <section class="ct">
    <div class="ct__bg" aria-hidden="true"></div>
    <div class="wrap grid ct__in">
      <div class="ct__intro">
        <p class="label">ETDLedger / Contact</p>
        <h1 class="display ct__title">Tell us what you run.</h1>
        <p class="lead">Whether it's a demo of InfraLedger or help with security, SAP or Oracle, a few details help us bring the right engineer to the first conversation.</p>
        <dl class="ct__facts">
          <div><dt class="label">Email</dt><dd><a class="ulink mono" href={`mailto:${email}`}>{email}</a></dd></div>
          <div><dt class="label">What happens next</dt><dd>An engineer reviews your request and replies to schedule a call.</dd></div>
        </dl>
      </div>

      <form class="form card" data-form data-endpoint={endpoint} data-email={email} novalidate>
        <div class="form__grid">
          <label class="f"><span class="label">Name</span><input name="name" autocomplete="name" required /><em class="f__err">Please enter your name.</em></label>
          <label class="f"><span class="label">Work email</span><input name="email" type="email" autocomplete="email" required /><em class="f__err">Please enter a valid email address.</em></label>
          <label class="f"><span class="label">Company</span><input name="company" autocomplete="organization" required /><em class="f__err">Please enter your company.</em></label>
          <label class="f"><span class="label">Role <i>optional</i></span><input name="role" autocomplete="organization-title" /></label>
        </div>

        <fieldset class="f f--set">
          <legend class="label">Interested in</legend>
          <div class="chips">
            {interests.map(([v, l]) => (
              <label class="chip"><input type="checkbox" name="interest" value={v} /><span>{l}</span></label>
            ))}
          </div>
          <em class="f__err">Choose at least one.</em>
        </fieldset>

        <label class="f"><span class="label">Infrastructure today <i>optional</i></span>
          <select name="size">
            <option value="">Select…</option>
            {sizes.map((s) => <option>{s}</option>)}
          </select>
        </label>

        <label class="f"><span class="label">Message</span>
          <textarea name="message" rows="5" required placeholder="What are you running today, and what would you like to change?"></textarea>
          <em class="f__err">Please add a short message.</em>
        </label>

        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="form__foot">
          <button class="btn btn--signal" type="submit" data-submit>Send request <span class="arrow">→</span></button>
          <p class="form__status" data-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  .ct { position: relative; margin-top: -64px; padding: 168px 0 136px; overflow: hidden; }
  .ct__bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(800px 380px at 18% -60px, color-mix(in srgb, var(--signal) 16%, transparent), transparent 70%),
      repeating-linear-gradient(to bottom, transparent 0 47px, var(--rule-soft) 47px 48px);
    -webkit-mask: radial-gradient(1200px 600px at 30% 0, #000 30%, transparent 78%);
    mask: radial-gradient(1200px 600px at 30% 0, #000 30%, transparent 78%);
  }
  .ct .wrap { position: relative; }
  .ct__in { row-gap: 56px; align-items: start; }
  .ct__intro { grid-column: 1 / span 5; position: sticky; top: 112px; }
  .ct__title { font-size: clamp(44px, 5.4vw, 76px); margin: 24px 0 24px; }
  .ct__facts { margin-top: 40px; border-top: 1px solid var(--rule-strong); }
  .ct__facts > div { padding: 14px 0; border-bottom: 1px solid var(--rule); display: grid; gap: 4px; }
  .ct__facts dd { font-size: 15px; }
  .form { grid-column: 7 / span 6; display: grid; gap: 26px; min-width: 0; padding: 32px; }
  .form:hover { background: color-mix(in srgb, var(--surface) 70%, transparent); }
  .form > *, .form__grid > * { min-width: 0; }
  @media (max-width: 960px) {
    .ct__intro, .form { grid-column: 1 / -1; position: static; }
  }

  .form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px var(--gutter); }
  @media (max-width: 600px) { .form__grid { grid-template-columns: 1fr; } }

  .f { display: grid; gap: 8px; border: 0; min-width: 0; }
  .f .label i { font-style: normal; text-transform: none; letter-spacing: 0; color: var(--ink-3); opacity: 0.8; margin-left: 6px; }
  .f input, .f select, .f textarea {
    width: 100%; font: inherit; font-size: 16px; color: var(--ink);
    background: var(--paper); border: 1px solid var(--rule);
    padding: 11px 14px; border-radius: 10px; outline: none;
    transition: border-color 200ms var(--ease), box-shadow 200ms var(--ease);
  }
  .f textarea { resize: vertical; }
  .f select { appearance: none; background: linear-gradient(45deg, transparent 50%, var(--ink) 50%) right 18px center / 5px 5px no-repeat, linear-gradient(-45deg, transparent 50%, var(--ink) 50%) right 13px center / 5px 5px no-repeat, var(--paper); }
  .f input:focus, .f select:focus, .f textarea:focus { border-color: color-mix(in srgb, var(--signal) 60%, transparent); box-shadow: 0 0 0 4px var(--signal-soft); }
  .f__err { display: none; font-style: normal; font-size: 13px; color: var(--signal); }
  .f.is-invalid .f__err { display: block; }
  .f.is-invalid input, .f.is-invalid textarea { border-color: var(--signal); }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .chip { position: relative; }
  .chip input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; pointer-events: none; }
  .chip span {
    display: inline-block; padding: 8px 14px; font-size: 14px; cursor: pointer;
    border: 1px solid var(--rule); border-radius: 999px; background: var(--paper);
    transition: background-color 200ms var(--ease), color 200ms var(--ease), border-color 200ms var(--ease);
  }
  .chip span:hover { border-color: var(--ink-3); }
  .chip input:checked + span { background: var(--ink); color: var(--on-solid); border-color: var(--ink); }
  .chip input:focus-visible + span { outline: 2px solid var(--signal); outline-offset: 2px; }

  .hp { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; clip: rect(0 0 0 0); }
  .form__foot { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; border-top: 1px solid var(--rule-soft); padding-top: 24px; }
  .form__status { font-size: 14px; color: var(--ink-2); }
  .form__status.is-ok { color: var(--ok); }
  .form__status.is-bad { color: var(--signal); }
  .btn[disabled] { opacity: 0.6; cursor: progress; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-form]")!;
  const status = form.querySelector<HTMLElement>("[data-status]")!;
  const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;

  const preset = new URLSearchParams(location.search).get("interest");
  if (preset) form.querySelectorAll<HTMLInputElement>("input[name=interest]").forEach((c) => (c.checked = c.value === preset));

  const setStatus = (msg: string, kind = "") => {
    status.textContent = msg;
    status.className = "form__status" + (kind ? ` is-${kind}` : "");
  };

  const validate = () => {
    let first: HTMLElement | null = null;
    const check = (wrap: Element | null, ok: boolean) => {
      wrap?.classList.toggle("is-invalid", !ok);
      if (!ok && !first) first = wrap?.querySelector("input, textarea") ?? null;
    };
    for (const name of ["name", "company", "message"]) {
      const el = form.elements.namedItem(name) as HTMLInputElement;
      check(el.closest(".f"), el.value.trim().length > 0);
    }
    const mail = form.elements.namedItem("email") as HTMLInputElement;
    check(mail.closest(".f"), /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail.value.trim()));
    const boxes = form.querySelectorAll<HTMLInputElement>("input[name=interest]");
    check(form.querySelector(".f--set"), [...boxes].some((b) => b.checked));
    (first as HTMLElement | null)?.focus();
    return !first;
  };

  form.addEventListener("input", (e) => {
    const wrap = (e.target as HTMLElement).closest(".f");
    if (wrap?.classList.contains("is-invalid")) validate();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!validate()) return setStatus("Please check the highlighted fields.", "bad");

    const fd = new FormData(form);
    if (fd.get("website")) return;
    fd.delete("website");
    const data = {
      name: String(fd.get("name")).trim(),
      email: String(fd.get("email")).trim(),
      company: String(fd.get("company")).trim(),
      role: String(fd.get("role") ?? "").trim(),
      interest: fd.getAll("interest").join(", "),
      size: String(fd.get("size") ?? ""),
      message: String(fd.get("message")).trim(),
    };

    const endpoint = form.dataset.endpoint;
    if (!endpoint) {
      const body = Object.entries(data).filter(([, v]) => v).map(([k, v]) => `${k[0].toUpperCase() + k.slice(1)}: ${v}`).join("\n");
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Enquiry from ${data.company}`)}&body=${encodeURIComponent(body)}`;
      return setStatus("Your email app should open with the message ready to send.", "ok");
    }

    submit.disabled = true;
    setStatus("Sending…");
    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      setStatus("Thanks — your request is in. We'll reply by email.", "ok");
    } catch {
      setStatus(`Something went wrong. Please email us at ${form.dataset.email}.`, "bad");
    } finally {
      submit.disabled = false;
    }
  });
</script>
