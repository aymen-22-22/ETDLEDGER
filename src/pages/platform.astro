---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SpecSection from "../components/SpecSection.astro";
import Architecture from "../components/Architecture.astro";
import Cta from "../components/Cta.astro";

const index = [
  { num: "01", label: "Deploy", href: "#deploy" },
  { num: "02", label: "Data services", href: "#data" },
  { num: "03", label: "Networking", href: "#network" },
  { num: "04", label: "Architecture", href: "#architecture" },
  { num: "05", label: "Observability", href: "#observe" },
  { num: "06", label: "Access & tenancy", href: "#access" },
];

const services = [
  ["PostgreSQL", "Versioned databases, automated backups, connection credentials, resource limits"],
  ["MySQL / MariaDB", "Versioned databases, automated backups, connection credentials, resource limits"],
  ["Redis", "In-memory cache and store, with persistence options"],
  ["Object storage", "S3-compatible buckets, access keys and lifecycle policies"],
  ["RabbitMQ", "Managed message queues"],
];
---
<Base
  title="Platform — InfraLedger by ETDLedger"
  description="Deploys, managed databases, networking, observability and multi-tenant access control on infrastructure you run."
>
  <PageHero
    label="InfraLedger / Platform"
    title="The platform your team would build, already built."
    lead="InfraLedger turns raw servers, from a single Docker host to a Kubernetes cluster, into a self-service platform. Developers deploy, provision and operate from a dashboard, without Docker commands, YAML or SSH."
    index={index}
  />

  <SpecSection
    id="deploy"
    num="01"
    label="Deploy"
    title="Push code, get a running service."
    lead="Two ways in: connect a Git repository, or point at any container registry image. Every app comes out the other side with HTTPS, scaling and a deploy history."
    items={[
      ["Git-based deploys", "Connect a repository. InfraLedger detects a Dockerfile, or falls back to buildpacks, then builds and deploys on push."],
      ["Image deploys", "Point at any registry image and run it directly, with the same routing and scaling as Git deploys."],
      ["Automatic HTTPS", "Every app gets a domain and a certificate through Traefik and Let's Encrypt, including app.localhost for local development."],
      ["Horizontal scaling", "Run multiple replicas behind a built-in load balancer, with health checks and sticky sessions."],
      ["Environment variables", "Encrypted at rest, with project-level shared secrets that apps can reference."],
      ["Preview environments", "Every branch or pull request can get its own isolated, disposable deployment."],
      ["Deploy history", "Each deployment is tracked with build logs, commit SHA and status."],
      ["Console and scheduled jobs", "Open a shell in a running container from the browser, and run cron or one-off jobs in the app's environment."],
    ]}
  />

  <SpecSection
    id="data"
    num="02"
    label="Data services"
    title="Databases in a few clicks, isolated by default."
    lead="Each data service is provisioned on persistent storage, inside its project's private network, monitored for resource usage and backed up on a schedule with restore support."
    items={[]}
  >
    <div class="grid">
      <div class="svc card" data-rise>
        <div class="svc__row svc__row--head"><span class="label">Service</span><span class="label">Included</span></div>
        {services.map(([n, d]) => (
          <div class="svc__row"><span class="svc__n">{n}</span><span class="svc__d">{d}</span></div>
        ))}
      </div>
    </div>
  </SpecSection>

  <SpecSection
    id="network"
    num="03"
    label="Networking"
    title="Real tenant isolation, not a naming convention."
    lead="Routing, DNS and firewall rules are set in the dashboard and compiled into reverse-proxy configuration automatically."
    items={[
      ["Private networks per project", "Workloads in one project cannot reach another project's services unless they're explicitly connected."],
      ["Custom routing rules", "Path-based routing, redirects, rate limiting, IP allow-lists and basic auth, without hand-written proxy config."],
      ["DNS zone management", "Manage DNS records for your own domains directly in the platform."],
      ["Template catalog", "One-click starting points for common stacks, such as WordPress or a Node and Postgres starter."],
    ]}
  />

  <Architecture num="04" />

  <SpecSection
    id="observe"
    num="05"
    label="Observability"
    title="See what's running, and what changed."
    lead="Metrics, logs and alerts sit next to the deploy history, so problems line up with the change that caused them."
    items={[
      ["Metrics", "CPU, memory, request rate and error rate for every app and service, powered by Prometheus."],
      ["Centralized logs", "Streamed, searchable logs for every application and service."],
      ["Alerting", "Threshold-based alerts delivered to Slack, email or any webhook."],
      ["Usage dashboards", "Per-project and per-organization views of what is consuming what."],
      ["Staged changes", "Queue configuration changes and review a diff before applying them. In progress."],
      ["One-click rollback", "Revert a deployment with a preview of exactly what will and won't revert: env vars, image, replicas. In progress."],
    ]}
  />

  <SpecSection
    id="access"
    num="06"
    label="Access & tenancy"
    title="Multi-tenant from the first line of code."
    lead="Organizations are the tenant boundary. Every organization's resources are fully isolated from every other, and every action is recorded."
    items={[
      ["Organizations and projects", "Organizations hold projects; projects group the applications, databases and services that belong together."],
      ["Role-based access", "Owner, Admin and Member roles, enforced on every API call rather than just hidden in the interface."],
      ["Audit log", "Every deploy, restart, delete, config change and admin action, recorded with actor, timestamp and outcome."],
      ["Platform admin panel", "A separate console to manage organizations, suspend abusive tenants and view system health."],
      ["Authentication", "Email and password accounts with JWT-based sessions."],
      ["Engineering console UX", "Dense, keyboard-navigable interface with a ⌘K command palette and light, dark and high-contrast themes."],
    ]}
  />

  <Cta num="07" />
</Base>

<style>
  .svc { grid-column: 4 / span 9; padding: 4px 24px; }
  .svc__row {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); column-gap: var(--gutter);
    padding: 18px 0; border-bottom: 1px solid var(--rule-soft);
  }
  .svc__row:last-child { border-bottom: 0; }
  .svc__row--head { padding: 14px 0; }
  .svc__n { font-weight: 600; letter-spacing: -0.01em; }
  .svc__d { color: var(--ink-2); font-size: 15px; }
  @media (max-width: 900px) {
    .svc { grid-column: 1 / -1; }
    .svc__row { grid-template-columns: 1fr; row-gap: 4px; }
  }
</style>

<script>
  import "../scripts/motion.ts";
</script>
