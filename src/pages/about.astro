---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Cta from "../components/Cta.astro";

const index = [
  { num: "01", label: "The name", href: "#name" },
  { num: "02", label: "What we do", href: "#work" },
  { num: "03", label: "Principles", href: "#principles" },
  { num: "04", label: "How we build", href: "#build" },
];

const name = [
  ["Enterprise", "We work with organizations whose infrastructure, data and systems have to be dependable, auditable and theirs."],
  ["Threat Detection", "Security is not a separate product line. It's the reason we record everything, and the lens we review systems through."],
  ["Ledger", "An ordered, complete record of every change. It's how InfraLedger works, and how we think about operating infrastructure."],
];

const work = [
  { code: "01", title: "InfraLedger", text: "A self-hosted, multi-tenant cloud platform that turns your servers into a self-service platform for apps, databases and clusters.", href: "/platform", link: "The platform" },
  { code: "02", title: "Security", text: "Threat detection, security assessments and compliance readiness, built on a complete record of what happens in your infrastructure.", href: "/security", link: "Security services" },
  { code: "03", title: "Enterprise systems", text: "SAP, Oracle and managed Kubernetes, delivered on infrastructure you control rather than a single vendor's cloud.", href: "/enterprise", link: "Enterprise services" },
];

const principles = [
  ["Your infrastructure, your control", "We build for teams that need to own where their workloads and data live. InfraLedger depends on no third-party cloud API."],
  ["Record everything", "If an action changes your systems, it should leave an entry with an actor, a time and an outcome. Detection and accountability start there."],
  ["Enforce, don't just name", "Isolation and permissions are checked on every request. A boundary that's only a naming convention isn't a boundary."],
  ["Grow without rewriting", "Start on one server and move to a cluster without changing how your team works. Architecture should absorb growth."],
  ["Built for engineers", "Dense, fast, keyboard-first tools that respect the people using them every day."],
  ["Say what's true", "We describe what our products do today, and label what's still in progress."],
];

const facts = [
  ["Founded", "2023"],
  ["Headquarters", "Sidi Bel Abbès, Algeria"],
  ["Team", "20 people"],
  ["Focus", "Platform · Security · Enterprise"],
];

const stack = [
  ["Backend", "NestJS and Prisma"],
  ["Frontend", "React and Vite"],
  ["Data layer", "PostgreSQL"],
  ["Routing", "Traefik with Let's Encrypt"],
  ["Metrics", "Prometheus"],
  ["Runtimes", "Docker, Kubernetes, vcluster"],
];
---
<Base title="About — ETDLedger" description="ETDLedger builds InfraLedger and delivers security and enterprise systems services, for organizations that want control of their infrastructure.">
  <PageHero
    label="ETDLedger / Company"
    title="We build infrastructure you can account for."
    lead="ETDLedger is an engineering company. We make InfraLedger, a self-hosted cloud platform, and we deliver the security and enterprise systems work that surrounds it, for organizations that want to own and understand their infrastructure."
    index={index}
  />

  <section class="facts">
    <div class="wrap">
      <dl class="facts__row">
        {facts.map(([k, v]) => (
          <div class="facts__cell"><dt class="label">{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="sec" id="name">
    <div class="wrap">
      <SectionHead num="01" label="The name" title="Enterprise Threat Detection Ledger." lead="Each part of the name describes part of how we work." />
      <div class="grid">
        <div class="nm">
          {name.map(([t, d], i) => (
            <div class="nm__row" data-rise>
              <span class="mono nm__i">{["E", "TD", "Ledger"][i]}</span>
              <p class="nm__t">{t}</p>
              <p class="nm__d">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="sec night" id="work">
    <div class="wrap">
      <SectionHead num="02" label="What we do" title="One product, two practices." lead="InfraLedger is our core product. Our security and enterprise teams work on the systems around it, and often on systems that never touch it." />
      <div class="wk">
        {work.map((w) => (
          <a class="wk__col" href={u(w.href)} data-rise>
            <span class="mono wk__code">{w.code}</span>
            <h3 class="h3">{w.title}</h3>
            <p class="body-2">{w.text}</p>
            <span class="wk__link">{w.link} <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="principles">
    <div class="wrap">
      <SectionHead num="03" label="Principles" title="What we hold ourselves to." />
      <div class="grid">
        <ol class="pr">
          {principles.map(([t, d], i) => (
            <li data-rise>
              <span class="mono pr__n">{String(i + 1).padStart(2, "0")}</span>
              <p class="pr__t">{t}</p>
              <p class="body-2">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="sec" id="build">
    <div class="wrap">
      <SectionHead num="04" label="How we build" title="Open, conventional technology." lead="InfraLedger is a monorepo built on widely used open-source tools, so the platform is understandable to the engineers who run it." />
      <div class="grid">
        <dl class="st" data-rise>
          {stack.map(([k, v]) => (
            <div class="st__row"><dt class="label">{k}</dt><dd class="mono">{v}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <Cta
    num="05"
    title="Let's talk about your infrastructure."
    interest="other"
    button="Get in touch"
    steps={[
      ["01", "Tell us what you run", "Your platform, systems and what you'd like to change."],
      ["02", "Meet the right engineer", "Platform, security or enterprise systems, depending on your needs."],
      ["03", "Decide on next steps", "A demo, an assessment or a scoped proposal."],
    ]}
  />
</Base>

<style>
  .facts { padding-bottom: 24px; }
  .facts__row {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule);
  }
  .facts__cell { padding: 20px 24px 22px 0; display: grid; gap: 8px; align-content: start; }
  .facts__cell + .facts__cell { border-left: 1px solid var(--rule); padding-left: 24px; }
  .facts__cell dd { font-size: clamp(20px, 2vw, 26px); font-weight: 500; letter-spacing: -0.015em; }
  @media (max-width: 900px) {
    .facts__row { grid-template-columns: 1fr 1fr; }
    .facts__row .facts__cell:nth-child(odd) { border-left: 0; padding-left: 0; }
    .facts__row .facts__cell:nth-child(even) { padding-left: 16px; }
    .facts__cell:nth-child(n + 3) { border-top: 1px solid var(--rule); }
  }
  .nm { grid-column: 4 / span 9; border-top: 1px solid var(--ink); }
  .nm__row {
    display: grid; grid-template-columns: 80px minmax(0, 1fr) minmax(0, 1.6fr); column-gap: var(--gutter);
    padding: 28px 0; border-bottom: 1px solid var(--rule); align-items: baseline;
  }
  .nm__i { color: var(--signal); font-size: 13px; }
  .nm__t { font-size: 24px; font-weight: 500; letter-spacing: -0.015em; }
  .nm__d { color: var(--ink-2); font-size: 15px; }
  @media (max-width: 900px) {
    .nm { grid-column: 1 / -1; }
    .nm__row { grid-template-columns: 56px 1fr; row-gap: 8px; }
    .nm__d { grid-column: 2; }
  }

  .wk { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: var(--gutter); }
  .wk__col {
    display: flex; flex-direction: column; gap: 12px;
    border-top: 1px solid var(--night-ink-3); padding: 20px 0 8px;
    transition: border-color 300ms var(--ease);
  }
  .wk__col:hover { border-top-color: var(--signal); }
  .wk__code { font-size: 12px; color: var(--signal); margin-bottom: 8px; }
  .wk__link { margin-top: auto; padding-top: 12px; font-size: 15px; font-weight: 500; }
  .wk__col:hover .arrow { transform: translateX(3px); }
  .wk__link .arrow { display: inline-block; transition: transform 200ms var(--ease); }
  @media (max-width: 900px) { .wk { grid-template-columns: 1fr; row-gap: 40px; } }

  .pr {
    grid-column: 4 / span 9; list-style: none;
    display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--gutter);
    border-top: 1px solid var(--ink);
  }
  .pr li { display: grid; grid-template-columns: 40px 1fr; padding: 22px 0 26px; border-bottom: 1px solid var(--rule); }
  .pr li .body-2 { grid-column: 2; margin-top: 6px; }
  .pr__n { font-size: 12px; color: var(--signal); padding-top: 4px; }
  .pr__t { font-weight: 500; font-size: 17px; }
  @media (max-width: 900px) { .pr { grid-column: 1 / -1; grid-template-columns: 1fr; } }

  .st { grid-column: 4 / span 9; border-top: 1px solid var(--ink); display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--gutter); }
  .st__row { display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--rule); }
  .st__row dd { font-size: 13px; text-align: right; }
  @media (max-width: 900px) { .st { grid-column: 1 / -1; grid-template-columns: 1fr; } }
</style>

<script>
  import "../scripts/motion.ts";
</script>
