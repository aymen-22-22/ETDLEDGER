---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
---
<Base title="Page not found — ETDLedger" description="The page you were looking for doesn't exist." noindex>
  <section class="nf">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="h1 nf__title">This page doesn't exist</h1>
      <p class="lead">The link may be out of date, or the address may be mistyped.</p>
      <div class="nf__actions">
        <a class="btn btn--primary" href={u("/")}>Back to home</a>
        <a class="btn btn--secondary" href={u("/docs")}>Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding: 144px 0 176px; }
  .nf__title { margin: 14px 0 18px; }
  .nf__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
</style>
