---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import PageHeader from "../components/PageHeader.astro";
import SubNav from "../components/SubNav.astro";
import FeatureRow from "../components/FeatureRow.astro";
import InfraTopologies from "../components/diagrams/InfraTopologies.astro";
import InfraLedgerArchitecture from "../components/diagrams/InfraLedgerArchitecture.astro";
import LogoCloud from "../components/LogoCloud.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CtaBand from "../components/CtaBand.astro";
import DeployMock from "../components/ui/DeployMock.astro";
import DashboardMock from "../components/ui/DashboardMock.astro";

const sub: [string, string][] = [
  ["deploy", "Deploy"],
  ["capabilities", "Data, network, observability"],
  ["access", "Access and audit"],
  ["architecture", "Architecture"],
  ["apps", "Templates"],
  ["stack", "Under the hood"],
];
const caps = [
  { title: "Data services", text: "Databases in a few clicks, on persistent storage inside each project's private network.", items: ["PostgreSQL, MySQL, MariaDB and Redis", "S3-compatible storage and RabbitMQ", "Scheduled backups with restore"] },
  { title: "Networking", text: "Routing, DNS and firewalls set in the dashboard, with no config files to edit.", items: ["Path routing, redirects and rate limits", "IP allow-lists and basic auth per app", "Projects can't reach each other by default"] },
  { title: "Observability", text: "Metrics, logs and alerts next to the deploy history, so a spike lines up with its cause.", items: ["CPU, memory, request and error rates", "Centralized, searchable logs", "Alerts to Slack, email or a webhook"] },
];
const access = [
  ["Organizations and projects", "Organizations are the tenant boundary. Projects group the apps, databases and services that belong together."],
  ["Roles enforced on every request", "Owner, Admin and Member roles are checked by the API on every call, not just hidden in the interface."],
  ["Audit log", "Every deploy, restart, deletion, configuration change and admin action, with who, when and the outcome."],
  ["Platform administration", "A separate console to manage organizations, suspend abusive tenants and view system health."],
];
const stack = [
  ["API", "NestJS and Prisma"],
  ["Dashboard", "React and Vite"],
  ["Platform data", "PostgreSQL"],
  ["Routing and TLS", "Traefik with Let's Encrypt"],
  ["Metrics", "Prometheus"],
  ["Runtimes", "Docker, Kubernetes, vcluster"],
];
const productLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "InfraLedger",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux",
  description: "A self-hosted, multi-tenant cloud platform for deploying applications and databases on your own servers, with an audit log of every action.",
  url: "https://etdledger.com/product",
  publisher: { "@id": "https://etdledger.com/#organization" },
};
---
<Base brand="infraledger" jsonld={[productLd]} title="Product — InfraLedger" description="Deploys, managed databases, networking, observability and an audit log of every action, on infrastructure you run.">
  <PageHeader stack brand="infraledger" eyebrow="InfraLedger" title="A self-service platform on your own servers" lead="InfraLedger turns raw servers into a self-service platform. Developers deploy, provision and operate from a dashboard, and you keep full control of the infrastructure.">
    <a class="btn btn--primary" href={u("/contact?interest=platform")}>Request early access <span class="arrow">→</span></a>
    <a class="btn btn--secondary" href={u("/docs")}>Read the docs</a>
    <DashboardMock slot="visual" />
  </PageHeader>
  <SubNav label="Product sections" items={sub} />

  <FeatureRow id="deploy" eyebrow="Deploy" title="Push code, get a running service"
    text="Connect a Git repository or point at any container image. InfraLedger builds it, issues a certificate and runs it behind a load balancer."
    items={[
      "Git deploys with Dockerfile detection or buildpacks",
      "Deploy any image from a container registry",
      "Automatic HTTPS for every app and custom domain",
      "A preview environment per branch, and a console into running containers",
    ]}>
    <DeployMock />
  </FeatureRow>

  <section class="section section--subtle" id="capabilities">
    <div class="container">
      <SectionHeader eyebrow="Platform services" title="Databases, networking and observability, built in" />
      <div class="caps">
        {caps.map((c, i) => (
          <div class="cap" data-reveal style={`--d:${i * 60}ms`}>
            <h3 class="h3">{c.title}</h3>
            <p class="muted">{c.text}</p>
            <ul class="checklist">{c.items.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="caps__note">In progress: staged configuration changes with a diff before applying, and one-click rollback with a preview of what will revert.</p>
    </div>
  </section>

  <section class="section" id="access">
    <div class="container">
      <SectionHeader eyebrow="Access and audit" title="Multi-tenant from the first line of code" lead="Organizations are fully isolated from each other, and every action is recorded." />
      <div class="grid-2">
        {access.map(([t, d], i) => (
          <div class="card" data-reveal style={`--d:${i * 60}ms`}>
            <p class="card__title">{t}</p>
            <p class="card__text">{d}</p>
          </div>
        ))}
      </div>
      <p class="more"><a class="link" href={u("/security")}>How InfraLedger protects your data</a></p>
    </div>
  </section>

  <section class="section section--subtle" id="architecture">
    <div class="container">
      <SectionHeader eyebrow="Architecture" title="Docker on one server, Kubernetes on a cluster" lead="A provider layer runs the same workloads on a single Docker host or a Kubernetes cluster, through the same dashboard and API. Moving from one to the other doesn't change how your developers work." />
      <div data-reveal><InfraTopologies /></div>
    </div>
  </section>

  <section class="section" id="apps">
    <div class="container">
      <SectionHeader center eyebrow="Templates" title="Open-source applications, one click away" lead="Start common applications from a template, with their database and storage set up for you." />
      <LogoCloud items={[
  ["siWordpress", "WordPress"], ["siOdoo", "Odoo"], ["siNextcloud", "Nextcloud"], ["siGitea", "Gitea"],
  ["siGitlab", "GitLab"], ["siGrafana", "Grafana"], ["siMetabase", "Metabase"], ["siKeycloak", "Keycloak"],
  ["siMattermost", "Mattermost"], ["siMinio", "MinIO"], ["siGhost", "Ghost"], ["siMoodle", "Moodle"],
]} />
    </div>
  </section>

  <section class="section section--subtle" id="stack">
    <div class="container stack">
      <SectionHeader eyebrow="Under the hood" title="Built on widely used open-source tools" />
      <dl class="stack__list" data-reveal>
        {stack.map(([k, v]) => <div><dt>{k}</dt><dd class="mono">{v}</dd></div>)}
      </dl>
    </div>
    <div class="container arch" data-reveal><InfraLedgerArchitecture /></div>
  </section>

  <CtaBand title="See InfraLedger on your servers" text="We'll set up an evaluation on infrastructure like yours." action="Request early access" />
</Base>

<style>
  .arch { margin-top: 64px; }
  .caps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; }
  .cap { display: grid; gap: 12px; align-content: start; padding-top: 20px; border-top: 1px solid var(--border-strong); }
  .cap .checklist { margin-top: 6px; }
  .caps__note { margin-top: 40px; font-size: 14px; color: var(--text-2); }
  @media (max-width: 900px) { .caps { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
  .more { margin-top: 28px; font-size: 15px; }
  .stack { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: start; }
  .stack :global(.section-header) { margin-bottom: 0; }
  .stack__list { border-top: 1px solid var(--border); }
  .stack__list div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .stack__list dt { color: var(--text-2); }
  .stack__list dd { display: flex; align-items: center; gap: 12px; text-align: right; }
  @media (max-width: 900px) { .stack { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
</style>
