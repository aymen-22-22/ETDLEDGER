---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { site } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
import SectionHeader from "../components/SectionHeader.astro";
import IsoDiagram from "../components/IsoDiagram.astro";
import LedgerMock from "../components/ui/LedgerMock.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";

const controlIcons = ["Building2", "KeyRound", "ScrollText", "Lock", "BrickWall", "ShieldCheck"] as const;

const controls = [
  ["Tenant isolation", "Each organization's resources are isolated from every other organization, and each project runs on its own private network."],
  ["Roles on every request", "Owner, Admin and Member roles are enforced by the API on every call, not only hidden in the interface."],
  ["Audit log", "Every deploy, restart, deletion, configuration change and admin action is recorded with the actor, time and outcome."],
  ["Encrypted secrets", "Environment variables and service credentials are encrypted at rest."],
  ["Application firewall", "IP allow-lists, basic auth and rate limits can be set for each application."],
  ["HTTPS by default", "Every application gets a certificate from Let's Encrypt, renewed automatically."],
];
---
<Base title="Security — InfraLedger" description="How InfraLedger protects your data: self-hosted by design, tenant isolation, roles enforced on every request, encrypted secrets and a complete audit log.">
  <PageHeader eyebrow="Security" title="Your data stays on your infrastructure" lead="InfraLedger is self-hosted by design. Applications, databases, logs and the audit log all live on servers you control, and nothing depends on a third-party cloud API." />

  <section class="section">
    <div class="container split">
      <div class="split__copy" data-reveal>
        <p class="eyebrow">Isolation</p>
        <h2 class="h2">Enforced boundaries, not naming conventions</h2>
        <p class="lead">Organizations are the tenant boundary, and projects inside them get separate private networks. A workload in one project can't open a connection to another project's services.</p>
      </div>
      <div data-reveal><IsoDiagram /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Built-in controls" title="Security that's part of the platform" lead="These controls apply to every organization and project. There's nothing to add on." />
      <div class="grid-3">
        {controls.map(([t, d], i) => (
          <div class="card" data-reveal style={`--d:${i * 50}ms`}>
            <span class="card__icon"><Icon name={controlIcons[i]} /></span>
            <p class="card__title">{t}</p>
            <p class="card__text">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container split">
      <div class="split__copy" data-reveal>
        <p class="eyebrow">Audit log</p>
        <h2 class="h2">A complete record, stored where you choose</h2>
        <p class="lead">The audit log is kept in InfraLedger's own database on your servers. It records successful and failed actions, so you can answer who changed what, and when.</p>
        <p class="muted">ETDLedger's security team can build threat detection on top of this record. <a class="link" href={u("/services#security")}>See security services</a></p>
      </div>
      <LedgerMock />
    </div>
  </section>

  <section class="section">
    <div class="container access">
      <div data-reveal>
        <p class="eyebrow">Access</p>
        <h2 class="h2">Who can reach your platform</h2>
      </div>
      <div class="access__text" data-reveal>
        <p class="lead">Only people you invite. ETDLedger staff have no access to your installation unless you grant it, for example for a support request, and you can revoke it at any time.</p>
        <p class="muted">Found a vulnerability? Email <a class="link" href={`mailto:${site.email}`}>{site.email}</a> and we'll respond as quickly as we can.</p>
      </div>
    </div>
  </section>

  <CtaBand title="Review InfraLedger with your security team." text="We'll walk your team through the architecture, controls and audit log." />
</Base>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 64px; align-items: center; }
  .split__copy { display: grid; gap: 18px; align-content: start; }
  @media (max-width: 900px) { .split { grid-template-columns: minmax(0, 1fr); gap: 40px; } }
  .access { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 64px; }
  .access .eyebrow { margin-bottom: 16px; }
  .access__text { display: grid; gap: 18px; }
  @media (max-width: 900px) { .access { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
</style>
