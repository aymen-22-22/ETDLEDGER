---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import PageHeader from "../components/PageHeader.astro";
import SubNav from "../components/SubNav.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FeatureRow from "../components/FeatureRow.astro";
import CtaBand from "../components/CtaBand.astro";
import SecurityFlow from "../components/diagrams/SecurityFlow.astro";
import { brands } from "../lib/brands";
import BrandLogo from "../components/BrandLogo.astro";
import LogoCloud from "../components/LogoCloud.astro";
import DashboardMock from "../components/ui/DashboardMock.astro";
import Photo from "../components/Photo.astro";

const sub: [string, string][] = [
  ["platform", "Platform"],
  ["security", "Security"],
  ["enterprise", "Enterprise systems"],
  ["infraledger", "InfraLedger"],
  ["engagement", "How we work"],
];
const enterprise: { id: "sap" | "oracle" | "odoo"; title: string; text: string; items: string[] }[] = [
  { id: "sap", title: "SAP", text: "Implementation, migration and integration across SAP landscapes.", items: ["Module rollout aligned to your processes", "Migrations with cutover and rollback plans", "Integration with your other systems"] },
  { id: "oracle", title: "Oracle", text: "Database administration, standby databases and migrations.", items: ["Tuning, patching, backup and recovery", "Standby databases and recovery tests", "Upgrades and platform moves"] },
  { id: "odoo", title: "Odoo", text: "ERP implementation and customization, hosted on your servers.", items: ["CRM, sales, inventory and accounting", "Custom modules and integrations", "Hosting on InfraLedger with backups"] },
];
const steps = [
  ["Discover", "We map your systems, constraints and goals in a scoping call."],
  ["Plan", "A written plan with scope, timeline, risks and rollback."],
  ["Deliver", "Our engineers do the work with your team, in agreed stages."],
  ["Support", "Handover, documentation and ongoing support if you need it."],
];
const servicesLd = [
  ["Platform services", "InfraLedger rollout and operation, and managed Kubernetes.", "platform"],
  ["Security services", "Threat detection, security assessments, compliance readiness and cyber labs.", "security"],
  ["Enterprise systems", "SAP, Oracle and Odoo implementation, migration and support.", "enterprise"],
].map(([name, description, id]) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name,
  description,
  url: `https://etdledger.com/#${id}`,
  provider: { "@id": "https://etdledger.com/#organization" },
  areaServed: "DZ",
}));
---
<Base jsonld={servicesLd} title="ETDLedger — platform, security and enterprise systems engineering" description="Platform, security and enterprise systems services from ETDLedger's engineering team: Kubernetes, security assessments, cyber labs, SAP, Oracle and Odoo.">
  <PageHeader eyebrow="ETDLedger" title="Engineers for the systems your business runs on" lead="Our team works in three practices: platform operations, security, and enterprise systems. On-premises or hybrid.">
    <a class="btn btn--primary" href={u("/contact?interest=other")}>Talk to our team <span class="arrow">→</span></a>
  </PageHeader>
  <SubNav label="Services" items={sub} />
  <div class="container photo-band">
    <Photo items={[
      { file: "services-datacenter.jpg", alt: "Server racks in a data center" },
      { file: "services-security.jpg", alt: "Engineers monitoring security dashboards" },
      { file: "services-team.jpg", alt: "Engineers working together at a desk" },
    ]} />
  </div>

  <FeatureRow id="platform" eyebrow="Platform" icon="Server"
    title="InfraLedger and Kubernetes, run with you"
    text="We install and operate InfraLedger with your team, and run isolated virtual Kubernetes clusters you can offer to customers or business units."
    items={[
      "Installation, sizing and onboarding",
      "An isolated virtual cluster per customer, with kubectl access",
      "Design of the underlying Kubernetes infrastructure",
      "Upgrades, capacity planning and incident support",
    ]} />

  <FeatureRow id="security" eyebrow="Security" icon="ShieldCheck" subtle
    title="Security work, scoped to your environment"
    text="Detection, assessments and compliance work, on its own or alongside an InfraLedger deployment."
    items={[
      "Detection rules and alert routing for deploy, access and configuration events",
      "Penetration testing and configuration reviews, with findings ranked by risk",
      "Controls and audit trails mapped to your auditors' framework",
      "Cyber labs: isolated training environments for your security team",
    ]}>
    <SecurityFlow />
  </FeatureRow>
  <div class="container below">
    <LogoCloud compact items={[
      ["siElasticstack", "Elastic Stack"], ["siSplunk", "Splunk"], ["siGrafana", "Grafana"], ["siPfsense", "pfSense"],
      ["siOpnsense", "OPNsense"], ["siWireguard", "WireGuard"], ["siOpenvpn", "OpenVPN"], ["siVault", "Vault"], ["siOwasp", "OWASP"],
    ]} />
    <p class="labs-link"><a class="link" href={u("/labs")}>About cyber labs</a></p>
  </div>

  <section class="section" id="enterprise">
    <div class="container">
      <SectionHeader eyebrow="Enterprise systems" title="SAP, Oracle and Odoo" lead="Implementation, migration and support for the business systems you depend on." />
      <div class="ents">
        {enterprise.map((e, i) => (
          <a class="ent" id={e.id} href={u(brands[e.id].href)} data-reveal style={`--d:${i * 60}ms; --c:${brands[e.id].color}`}>
            <span class="ent__logo" aria-label={e.title}>
              {e.id === "sap" && <BrandLogo brand="siSap" size={64} decorative />}
              {e.id === "odoo" && <BrandLogo brand="siOdoo" size={72} decorative />}
              {e.id === "oracle" && <span class="ent__word">ORACLE</span>}
            </span>
            <p class="card__text">{e.text}</p>
            <ul class="checklist ent__list">{e.items.map((x) => <li>{x}</li>)}</ul>
            <span class="ent__more">{e.title} solutions →</span>
          </a>        ))}
      </div>
      <div class="ent-logos">
        <LogoCloud compact items={[
          ["siSap", "SAP"], ["siOdoo", "Odoo"], ["siPostgresql", "PostgreSQL"], ["siMysql", "MySQL"],
          ["siRedhat", "Red Hat"], ["siApachekafka", "Kafka"], ["siRabbitmq", "RabbitMQ"], ["siPython", "Python"],
        ]} />
      </div>
    </div>
  </section>

  <FeatureRow id="infraledger" eyebrow="Our product" icon="LayoutDashboard" subtle
    title="InfraLedger, the self-hosted cloud platform"
    text="We build InfraLedger: a platform where developers deploy apps and databases on your own servers, with every action recorded in an audit log."
    items={[
      "Git and container deploys with automatic HTTPS",
      "Managed PostgreSQL, MySQL, Redis and object storage",
      "Runs on one Docker server or a Kubernetes cluster",
      "Organizations, roles and a complete audit log",
    ]}>
    <DashboardMock />
  </FeatureRow>
  <div class="container below"><p class="labs-link"><a class="link" href={u("/product")}>Explore InfraLedger</a></p></div>

  <section class="section" id="engagement">
    <div class="container">
      <SectionHeader eyebrow="How we work" title="From first call to support" lead="Engagements can be a fixed-scope project, a retained team or advisory work." />
      <ol class="steps4">
        {steps.map(([t, d], i) => (
          <li data-reveal style={`--d:${i * 60}ms`}>
            <span class="steps4__n">0{i + 1}</span>
            <p class="card__title">{t}</p>
            <p class="card__text">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand title="Tell us what you run" text="We'll put the right engineer on the first call." interest="other" action="Talk to our team" />
</Base>

<style>
  .below { margin-top: -72px; padding-bottom: 96px; display: grid; gap: 20px; }
  .labs-link { font-size: 15px; }
  .ents { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--border); }
  .ent { display: block; padding: 32px 28px 8px; border-left: 1px solid var(--border); }
  .ent:first-child { border-left: 0; padding-left: 0; }
  .ent__logo { display: flex; align-items: center; height: 64px; margin-bottom: 20px; color: var(--c); }
  .ent__word { font-size: 30px; font-weight: 700; letter-spacing: 0.12em; }
  :root[data-theme="dark"] #sap .ent__logo { color: #4da3ff; }
  :root[data-theme="dark"] #oracle .ent__logo { color: #f08a7a; }
  :root[data-theme="dark"] #odoo .ent__logo { color: #d6aecb; }
  .ent .ent__list { margin-top: 18px; }
  .ent:hover .ent__more { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .ents { grid-template-columns: minmax(0, 1fr); } .ent, .ent:first-child { padding: 28px 0; border-left: 0; border-bottom: 1px solid var(--border); } }
  .ent__more { display: block; margin-top: 18px; font-size: 14.5px; font-weight: 500; color: var(--text); }
  .ent-logos { margin-top: 32px; }
  .photo-band:has(.photos) { padding-top: 48px; }
  .ent__list { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 14.5px; }
  .steps4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .steps4 li { display: grid; gap: 8px; align-content: start; padding-top: 16px; border-top: 1px solid var(--border-strong); }
  .steps4__n { font-family: var(--mono); font-size: 13px; color: var(--text-3); }
  @media (max-width: 960px) { .steps4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .steps4 { grid-template-columns: minmax(0, 1fr); } }
</style>
