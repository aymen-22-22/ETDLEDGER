---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
import { site } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
import Photo from "../components/Photo.astro";
import SectionHeader from "../components/SectionHeader.astro";
import AlgeriaMap from "../components/AlgeriaMap.astro";
import { team } from "../lib/team";

const facts = [
  ["Founded", site.founded],
  ["Headquarters", site.city],
  ["Team", site.team],
];
// Our history as ledger entries. "Now" rows describe today; add dated milestones as they happen.
const history = [
  ["2023", "ETDLedger is founded in Sidi Bel Abbès"],
  ["Now", "InfraLedger, our self-hosted cloud platform, in early access"],
  ["Now", "Security, SAP, Oracle and Odoo practices"],
  ["Now", "A team of 20 engineers"],
];
const name = [
  ["Enterprise", "We work with organizations whose systems have to be dependable, auditable and their own."],
  ["Threat Detection", "Security isn't a separate product line. It's why we record everything, and how we review systems."],
  ["Ledger", "A complete, ordered record of every change. It's how InfraLedger works and how we operate infrastructure."],
];
const principles = [
  ["Your infrastructure, your control", "We build for teams that need to own where their workloads and data live."],
  ["Record everything", "If an action changes your systems, it should leave an entry with who, when and the outcome."],
  ["Enforce, don't just name", "Isolation and permissions are checked on every request."],
  ["Grow without rewriting", "Start on one server and move to a cluster without changing how your team works."],
  ["Built for engineers", "Fast, clear tools that respect the people who use them every day."],
  ["Say what's true", "We describe what our products do today, and label what's still in progress."],
];
---
<Base title="Company — ETDLedger" description="ETDLedger builds InfraLedger, the self-hosted cloud platform, and delivers security, SAP, Oracle, Odoo and Kubernetes services. Founded in 2023 in Sidi Bel Abbès, Algeria.">
  <PageHeader eyebrow="Company" title="We build infrastructure you can account for" lead="ETDLedger is an engineering company. We make InfraLedger, a self-hosted cloud platform, and deliver the security and enterprise systems work around it." />

  <section class="facts-band">
    <div class="container">
      <dl class="facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <div class="container photo-band">
    <Photo ratio="21 / 9" items={[{ file: "company-office.jpg", alt: "The ETDLedger office" }]} />
  </div>

  <section class="section">
    <div class="container story">
      <div>
        <SectionHeader eyebrow="Our ledger" title="Where we come from" lead="Like everything we build, our history is a list of entries. The latest one is highlighted." />
        <ol class="story__list" data-reveal>
          {history.map(([when, what], i) => (
            <li class:list={{ "is-now": i === history.length - 1 }}><span class="story__when">{when}</span><span>{what}</span></li>
          ))}
        </ol>
      </div>
      <div data-reveal><AlgeriaMap caption="Our office is in Sidi Bel Abbès, in north-west Algeria." /></div>
    </div>
  </section>

  {team.length > 0 && (
    <section class="section section--subtle">
      <div class="container">
        <SectionHeader eyebrow="Team" title="Who you'll work with" />
        <ul class="team">
          {team.map((p, i) => (
            <li data-reveal style={`--d:${i * 50}ms`}>
              <figure class="photo"><img src={u(`/photos/team/${p.photo}`)} alt={p.name} loading="lazy" decoding="async" /></figure>
              <p class="team__name">{p.name}</p>
              <p class="team__role">{p.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container name">
      <SectionHeader eyebrow="Our name" title="Enterprise Threat Detection Ledger" lead="Each part of the name describes how we work." />
      <div class="name__rows">
        {name.map(([t, d], i) => (
          <div class="name__row" data-reveal style={`--d:${i * 60}ms`}>
            <p class="h3">{t}</p>
            <p class="muted">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <SectionHeader eyebrow="Principles" title="What we hold ourselves to" />
      <div class="grid-3">
        {principles.map(([t, d], i) => (
          <div class="card" data-reveal style={`--d:${i * 40}ms`}>
            <p class="card__title">{t}</p>
            <p class="card__text">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container contact-row">
      <div data-reveal>
        <p class="eyebrow">Contact</p>
        <h2 class="h2">Get in touch</h2>
      </div>
      <dl class="contact-list" data-reveal>
        <div><dt>Email</dt><dd><a class="link" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Location</dt><dd>{site.city}</dd></div>
        <div><dt>Demo or project</dt><dd><a class="link" href={u("/contact")}>Send us a request</a></dd></div>
      </dl>
    </div>
  </section>

</Base>

<style>
  .story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 64px; align-items: center; }
  .story__list { border-top: 1px solid var(--border-strong); }
  .story__list li { position: relative; display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 16px; padding: 16px 0 16px 14px; border-bottom: 1px solid var(--border); }
  .story__when { font-family: var(--mono); font-size: 13px; color: var(--text-3); padding-top: 2px; }
  .story__list li.is-now { font-weight: 600; background: color-mix(in srgb, var(--brand-red) 6%, transparent); }
  .story__list li.is-now::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--brand-red); }
  .story__list li.is-now .story__when { color: var(--brand-red); }
  @media (max-width: 900px) { .story { grid-template-columns: minmax(0, 1fr); gap: 40px; } }
  .team { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .team img { aspect-ratio: 4 / 5; }
  .team__name { margin-top: 14px; font-weight: 600; }
  .team__role { font-size: 14px; color: var(--text-2); }
  @media (max-width: 900px) { .team { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .photo-band:has(.photos) { padding-top: 64px; }
  .facts-band { border-bottom: 1px solid var(--border); }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); }
  .facts div { padding: 28px 24px; display: grid; gap: 6px; }
  .facts div:first-child { padding-left: 0; }
  .facts div + div { border-left: 1px solid var(--border); }
  .facts dt { font-size: 14px; color: var(--text-2); }
  .facts dd { font-size: clamp(22px, 2.4vw, 30px); font-weight: 600; letter-spacing: -0.02em; }
  @media (max-width: 720px) {
    .facts { grid-template-columns: minmax(0, 1fr); }
    .facts div { padding: 20px 0; }
    .facts div + div { border-left: 0; border-top: 1px solid var(--border); }
  }

  .name { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 64px; align-items: start; }
  .name :global(.section-header) { margin-bottom: 0; }
  .name__rows { border-top: 1px solid var(--border); }
  .name__row { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--border); }
  @media (max-width: 900px) {
    .name { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .name__row { grid-template-columns: minmax(0, 1fr); gap: 6px; }
  }

  .contact-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 64px; }
  .contact-row .eyebrow { margin-bottom: 16px; }
  .contact-list { border-top: 1px solid var(--border); }
  .contact-list div { display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--border); }
  .contact-list dt { color: var(--text-2); }
  @media (max-width: 900px) { .contact-row { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
</style>
